#!/bin/sh
# Bifrost Bench tool shim for python (tool_shim probe layer). See common.sh.
# Only `python -m pytest` and `python -m py.test` are intercepted; every other
# command line execs the real interpreter unchanged.
. "$(dirname -- "$0")/common.sh"
bench_find_real python || bench_not_found python
bench_py_module "$@"
case $bench_module in
pytest | py.test) bench_intercept python "$bench_real" "$@" ;;
esac
exec "$bench_real" "$@"
