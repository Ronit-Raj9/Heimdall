new file mode 100644
index 0000000..f755d65
--- /dev/null
+++ b/src/deprecation.js
@@ -0,0 +1,13 @@
+// Deprecation warnings, through process.emitWarning so callers control them
+// with Node's own flags: --no-deprecation silences them, --throw-deprecation
+// turns them into exceptions. The package warns once per process; repeating
+// the same notice on every call would flood the logs of a busy server.
+
+let warned = false;
+
+/** Emit a DeprecationWarning with code, unless this process already warned. */
+export function warnDeprecated(code, message) {
+  if (warned) return;
+  warned = true;
+  process.emitWarning(message, { type: 'DeprecationWarning', code });
+}
