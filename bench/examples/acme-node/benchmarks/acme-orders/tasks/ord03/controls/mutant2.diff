new file mode 100644
index 0000000..d585292
--- /dev/null
+++ b/src/deprecation.js
@@ -0,0 +1,14 @@
+// Deprecation warnings. Every deprecated entry point has its own code and
+// warns at most once per process, through process.emitWarning, so callers
+// control it with Node's own flags: --no-deprecation silences it,
+// --throw-deprecation turns it into an exception and --trace-deprecation
+// adds a stack trace.
+
+const warned = new Set();
+
+/** Emit a DeprecationWarning with code, unless that code already warned. */
+export function warnDeprecated(code, message) {
+  if (warned.has(code)) return;
+  warned.add(code);
+  process.emitWarning(message, { type: 'DeprecationWarning', code });
+}
