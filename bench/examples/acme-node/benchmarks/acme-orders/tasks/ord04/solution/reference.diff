+// One lookup per distinct SKU: getMany in batches when the catalog has it,
+// else get. Returns a Map of the SKUs the catalog knows.
+function lookUp(catalog, skus) {
+  const distinct = [...new Set(skus)];
+  const items = new Map();
+  const keep = (sku, item) => {
+    if (item) items.set(sku, item);
+  };
+  if (typeof catalog.getMany === 'function') {
+    for (let i = 0; i < distinct.length; i += LOOKUP_BATCH) {
+      const batch = distinct.slice(i, i + LOOKUP_BATCH);
+      const found = catalog.getMany(batch);
+      for (const sku of batch) keep(sku, found.get(sku));
+    }
+  } else {
+    for (const sku of distinct) keep(sku, catalog.get(sku));
+  }
+  return items;
+}
