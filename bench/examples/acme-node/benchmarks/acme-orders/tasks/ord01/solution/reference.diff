diff --git a/src/dates.js b/src/dates.js
index 121d2b2..1547395 100644
--- a/src/dates.js
+++ b/src/dates.js
@@ -19,11 +19,19 @@ export function parseTimestamp(value) {
   }
   const m = TIMESTAMP_RE.exec(String(value).trim());
   if (!m) throw new RangeError(`invalid timestamp "${value}"`);
-  const [, year, month, day, hour, minute, second = '0', fraction = '0'] = m;
+  const [, year, month, day, hour, minute, second = '0', fraction = '0', zone] = m;
   if (!isCalendarDate(+year, +month, +day) || +hour > 23 || +minute > 59 || +second > 59) {
     throw new RangeError(`invalid timestamp "${value}"`);
   }
-  const millis = Date.UTC(+year, +month - 1, +day, +hour, +minute, +second, +fraction.padEnd(3, '0'));
+  let millis = Date.UTC(+year, +month - 1, +day, +hour, +minute, +second, +fraction.padEnd(3, '0'));
+  if (zone !== 'Z') {
+    const offsetHours = Number(zone.slice(1, 3));
+    const offsetMinutes = Number(zone.slice(4, 6));
+    if (offsetHours > 14 || offsetMinutes > 59) throw new RangeError(`invalid timestamp "${value}"`);
+    const sign = zone[0] === '-' ? -1 : 1;
+    // The clock reading is local to the offset; UTC is that reading minus the offset.
+    millis -= sign * (offsetHours * 60 + offsetMinutes) * 60000;
+  }
   return new Date(millis);
 }
 
