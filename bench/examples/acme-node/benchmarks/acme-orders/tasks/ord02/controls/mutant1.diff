+// A multi-buy promotion { sku, buy, get }: in every complete group of
+// buy + get units of sku on an order, get units are free. One per SKU.
+function normalizePromotions(list) {
+  if (!Array.isArray(list)) throw new OrderError('store: promotions must be an array');
+  const skus = new Set();
+  return list.map((raw, i) => {
+    const where = `store: promotion ${i + 1}`;
+    if (typeof raw?.sku !== 'string' || raw.sku.trim() === '') throw new OrderError(`${where}: sku is required`);
+    for (const key of ['buy', 'get']) {
+      if (!Number.isInteger(raw[key]) || raw[key] < 1) throw new OrderError(`${where}: ${key} must be a positive integer`);
+    }
+    if (skus.has(raw.sku)) throw new OrderError(`${where}: ${raw.sku} already has a promotion`);
+    skus.add(raw.sku);
+    return Object.freeze({ sku: raw.sku, buy: raw.buy, get: raw.get });
+  });
