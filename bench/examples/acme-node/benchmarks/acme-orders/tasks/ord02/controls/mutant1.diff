 }
+
+/**
+ * Cents each priced line gets off from the store's multi-buy promotions, in
+ * line order: every complete group of buy + get units on a line makes get
+ * units free.
+ */
+export function promotionDiscounts(store, lines) {
+  const bySku = new Map(store.promotions.map((p) => [p.sku, p]));
+  return lines.map((line) => {
+    const promotion = bySku.get(line.sku);
+    if (!promotion) return 0;
+    const free = Math.floor(line.qty / (promotion.buy + promotion.get)) * promotion.get;
+    return free * line.unitPrice;
+  });
+}
