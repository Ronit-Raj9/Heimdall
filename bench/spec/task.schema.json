{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximhq/bifrost/bench/spec/task.schema.json",
  "title": "Bifrost Bench task",
  "description": "benchmarks/<suite>/tasks/<id>/task.yaml: one task with a hidden verifier and admission controls. Mirrors schemas.Task. Every path is relative to the task folder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "project", "kind", "instruction", "repo_dir", "verifier", "controls", "timeouts"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "Equals the folder name."},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "title": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "kind": {"enum": ["bugfix", "feature", "refactor", "performance"]},
    "instruction": {"$ref": "#/$defs/rel_path"},
    "repo_dir": {"$ref": "#/$defs/rel_path"},
    "notes": {
      "type": "object",
      "description": "Optional. The clean file is installed as the agent's project notes file; the stale file feeds the stale-notes probe.",
      "additionalProperties": false,
      "required": ["clean"],
      "properties": {
        "clean": {"$ref": "#/$defs/rel_path"},
        "stale": {"$ref": "#/$defs/rel_path"},
        "stale_claims": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "required"],
      "properties": {
        "tests": {"$ref": "#/$defs/rel_path"},
        "answer": {"$ref": "#/$defs/rel_path", "description": "Hidden expected answer (an AnswerSpec in YAML) for a task with output kind answer."},
        "original_tests": {"$ref": "#/$defs/rel_path", "description": "Impossible tasks: folder of the unmutated tests the honest reference must pass."},
        "required": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[^\\s:][^:]*::\\S.*$"},
          "description": "Test ids that must run and pass: file.py::test_name (pytest), <import path>::TestName (go-test template) or test::<test name> (node-test template). Empty requires only that the verifier passes."
        }
      }
    },
    "protected": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "Globs of existing files whose hashes must not change (gate G1)."
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "empty", "mutants", "exploit"],
      "properties": {
        "reference": {"$ref": "#/$defs/rel_path"},
        "empty": {"$ref": "#/$defs/rel_path"},
        "mutants": {"type": "array", "items": {"$ref": "#/$defs/rel_path"}},
        "exploit": {"$ref": "#/$defs/rel_path"},
        "honest": {"$ref": "#/$defs/rel_path", "description": "Impossible tasks: the honest solution; it must pass original_tests and fail the task's tests."}
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_s"],
      "properties": {
        "agent_s": {"type": "integer", "minimum": 1}
      }
    },
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "description": "What the task exercises (planning, tool_use, test_discipline, error_recovery, safety, honesty, efficiency, ...), so results can be read per capability."
    },
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the task came from, so an imported or company-authored task can be traced and its license checked. Mirrors schemas.TaskProvenance.",
      "properties": {
        "source": {"type": "string", "minLength": 1, "description": "Repository URL or path the task was cut from."},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$", "description": "Commit the workspace snapshot was taken at."},
        "reference_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$", "description": "Commit holding the reference fix."},
        "license": {"type": "string", "minLength": 1, "description": "SPDX id, or proprietary."},
        "imported_from": {"type": "string", "minLength": 1, "description": "Benchmark and version, for imported tasks."},
        "created_by": {"type": "string", "minLength": 1, "description": "Tool that scaffolded the task, e.g. task init."}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "description": "The task's own image (docs/scenarios-design.md). Mirrors schemas.TaskEnvironment.",
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "dockerfile": {"$ref": "#/$defs/rel_path"},
        "context": {"$ref": "#/$defs/rel_path"},
        "workspace_path": {"type": "string", "pattern": "^/"},
        "verifier_image": {"type": "string", "minLength": 1},
        "build_network": {"type": "boolean"},
        "user": {"enum": ["root"], "description": "root runs the agent as root in the task's own image (docs/runner-safety.md)."}
      }
    },
    "services": {"type": "array", "items": {"$ref": "#/$defs/service"}, "description": "Started beside the agent, after the suite's services."},
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "instruction"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "instruction": {"$ref": "#/$defs/rel_path"},
          "files": {"$ref": "#/$defs/rel_path"},
          "keep_workspace": {"type": "boolean"},
          "wall_s": {"type": "integer", "minimum": 1}
        }
      }
    },
    "output": {"$ref": "#/$defs/output"},
    "skills": {"$ref": "#/$defs/rel_path", "description": "Folder of agent skills (each holding SKILL.md)."},
    "impossible": {"type": "boolean", "description": "The task has no honest solution; a pass is an integrity violation."}
  },
  "$defs": {
    "rel_path": {"type": "string", "minLength": 1, "pattern": "^[^/]"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["diff", "answer", "state"]},
        "answer_path": {"$ref": "#/$defs/rel_path"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "One container started beside the agent. Mirrors schemas.ServiceSpec.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["data", "tool", "mcp", "user"]},
        "image": {"type": "string", "minLength": 1},
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag"],
          "properties": {
            "dockerfile": {"$ref": "#/$defs/rel_path"},
            "tag": {"type": "string", "minLength": 1},
            "digest": {"type": "string"},
            "context": {"$ref": "#/$defs/rel_path"}
          }
        },
        "argv": {"type": "array", "items": {"type": "string"}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/rel_path"}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "ready": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argv": {"type": "array", "items": {"type": "string"}},
            "http": {"type": "string"},
            "timeout_s": {"type": "integer", "minimum": 1}
          }
        },
        "export": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
              "argv": {"type": "array", "items": {"type": "string"}},
              "path": {"type": "string", "pattern": "^/"},
              "max_bytes": {"type": "integer", "minimum": 1}
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transport": {"enum": ["http"]},
            "path": {"type": "string", "pattern": "^/"}
          }
        },
        "proxy": {"type": "boolean"},
        "hidden": {"type": "boolean"}
      }
    }
  }
}
