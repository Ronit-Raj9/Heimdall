{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximhq/bifrost/bench/spec/task.schema.json",
  "title": "Bifrost Bench task",
  "description": "benchmarks/<suite>/tasks/<id>/task.yaml: one task with a hidden verifier and admission controls. Mirrors schemas.Task. Every path is relative to the task folder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "project", "kind", "instruction", "repo_dir", "verifier", "controls", "timeouts"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "Equals the folder name."},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "title": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "kind": {"enum": ["bugfix", "feature", "refactor", "performance"]},
    "instruction": {"$ref": "#/$defs/rel_path"},
    "repo_dir": {"$ref": "#/$defs/rel_path"},
    "notes": {
      "type": "object",
      "description": "Optional. The clean file is installed as the agent's project notes file; the stale file feeds the stale-notes probe.",
      "additionalProperties": false,
      "required": ["clean"],
      "properties": {
        "clean": {"$ref": "#/$defs/rel_path"},
        "stale": {"$ref": "#/$defs/rel_path"},
        "stale_claims": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "required"],
      "properties": {
        "tests": {"$ref": "#/$defs/rel_path"},
        "answer": {"$ref": "#/$defs/rel_path", "description": "Hidden expected answer (an AnswerSpec in YAML) for a task with output kind answer."},
        "original_tests": {"$ref": "#/$defs/rel_path", "description": "Impossible tasks: folder of the unmutated tests the honest reference must pass."},
        "required": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[^\\s:][^:]*::\\S.*$"},
          "description": "Test ids that must run and pass: file.py::test_name (pytest), <import path>::TestName (go-test template) or test::<test name> (node-test template). Empty requires only that the verifier passes."
        }
      }
    },
    "protected": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "Globs of existing files whose hashes must not change (gate G1)."
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "empty", "mutants", "exploit"],
      "properties": {
        "reference": {"$ref": "#/$defs/rel_path"},
        "empty": {"$ref": "#/$defs/rel_path"},
        "mutants": {"type": "array", "items": {"$ref": "#/$defs/rel_path"}},
        "exploit": {"$ref": "#/$defs/rel_path"},
        "honest": {"$ref": "#/$defs/rel_path", "description": "Impossible tasks: the honest solution; it must pass original_tests and fail the task's tests."}
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_s"],
      "properties": {
        "agent_s": {"type": "integer", "minimum": 1}
      }
    },
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "metadata": {
      "type": "object",
      "description": "The task's own labels (tier, language, intent, any key) that report cards, comparisons and gates slice results by.",
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
      "additionalProperties": {"type": "string", "maxLength": 200},
      "maxProperties": 32
    },
    "chat": {
      "type": "object",
      "description": "A conversation task: the chat file (messages, scripted user turns, attachments) a chat agent receives as a messages array.",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {"$ref": "#/$defs/rel_path"},
        "user_turns": {"type": "integer", "minimum": 0, "maximum": 20},
        "grade_on": {"enum": ["final", "transcript"]}
      }
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "description": "What the task exercises (planning, tool_use, test_discipline, error_recovery, safety, honesty, efficiency, ...), so results can be read per capability."
    },
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "escalation": {"enum": ["expected", "not_expected"], "description": "W3 customer support: whether handing the customer to a human is the right outcome; read by the escalation_correct metric."},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the task came from, so an imported or company-authored task can be traced and its license checked. Mirrors schemas.TaskProvenance.",
      "properties": {
        "source": {"type": "string", "minLength": 1, "description": "Repository URL or path the task was cut from."},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$", "description": "Commit the workspace snapshot was taken at."},
        "reference_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$", "description": "Commit holding the reference fix."},
        "license": {"type": "string", "minLength": 1, "description": "SPDX id, or proprietary."},
        "imported_from": {"type": "string", "minLength": 1, "description": "Benchmark and version, for imported tasks."},
        "created_by": {"type": "string", "minLength": 1, "description": "Tool that scaffolded the task, e.g. task init."},
        "instruction_reviewed": {"type": "boolean", "description": "False when a tool drafted the instruction (tasks mine) and no human has reviewed it; task review sets it true."},
        "incident": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "description": "Failure inbox: the production incident the task was drafted from (inbox accept, docs/failure-inbox.md). Mirrors schemas.TaskIncident.",
          "properties": {
            "id": {"type": "string", "pattern": "^inc-[0-9a-f]{12}$"},
            "source": {"type": "string", "minLength": 1},
            "trace_id": {"type": "string", "minLength": 1},
            "link": {"type": "string", "minLength": 1},
            "first_seen": {"type": "string", "minLength": 1},
            "signature": {"type": "string", "pattern": "^f_[0-9a-f]{16}$"}
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "description": "The task's own image (docs/scenarios-design.md). Mirrors schemas.TaskEnvironment.",
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "dockerfile": {"$ref": "#/$defs/rel_path"},
        "context": {"$ref": "#/$defs/rel_path"},
        "workspace_path": {"type": "string", "pattern": "^/"},
        "verifier_image": {"type": "string", "minLength": 1},
        "build_network": {"type": "boolean"},
        "user": {"enum": ["root"], "description": "root runs the agent as root in the task's own image (docs/runner-safety.md)."},
        "env": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Variables set in the agent's, a control's and the verifier's container, under the plan's own (docs/multi-container.md)."}
      }
    },
    "services": {"type": "array", "items": {"$ref": "#/$defs/service"}, "description": "Started beside the agent, after the suite's services."},
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "instruction"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "instruction": {"$ref": "#/$defs/rel_path"},
          "files": {"$ref": "#/$defs/rel_path"},
          "keep_workspace": {"type": "boolean"},
          "wall_s": {"type": "integer", "minimum": 1}
        }
      }
    },
    "output": {"$ref": "#/$defs/output"},
    "skills": {"$ref": "#/$defs/rel_path", "description": "Folder of agent skills (each holding SKILL.md)."},
    "impossible": {"type": "boolean", "description": "The task has no honest solution; a pass is an integrity violation."},
    "allowed_irreversible": {"type": "array", "uniqueItems": true, "items": {"enum": ["data_destroy", "history_rewrite", "infra_destroy", "cloud_destroy", "service_delete"]}, "description": "Classes of irreversible action the task asks for; irreversible_without_confirmation does not fire on them."},
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "description": "Starts the approval channel (an MCP service named approver with request_approval and ask_user) and sets how it answers.",
      "properties": {
        "default": {"enum": ["approve", "deny"]},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision"],
            "properties": {
              "action": {"type": "string", "description": "Case-insensitive regular expression searched in the action."},
              "target": {"type": "string", "description": "Case-insensitive regular expression searched in the target."},
              "decision": {"enum": ["approve", "deny"]}
            }
          }
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["words", "answer"],
            "properties": {
              "words": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "answer": {"type": "string"}
            }
          }
        }
      }
    },
    "external": {"type": "array", "items": {"$ref": "#/$defs/external_api"}, "description": "Real HTTP APIs the agent may call through the tool proxy, after the suite's (docs/external-apis.md); cassette paths relative to the task folder."},
    "team": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/team_member"}, "description": "Multi-container team used when the agent config declares none (docs/multi-agent.md)."},
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "session_gap"],
      "description": "World clock: session n runs at start_date + (n-1) x session_gap (BENCH_DATE), and before each later session the engine POSTs /_world/tick to the task's services with the date and the events of the session that just ended.",
      "properties": {
        "start_date": {"type": "string", "minLength": 10},
        "session_gap": {"type": "string", "minLength": 2, "description": "e.g. 7d, 36h, 90m or any Go duration."},
        "events": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["after_session", "service", "action"], "properties": {"after_session": {"type": "integer", "minimum": 1}, "service": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}}}}
      }
    },
    "clock": {"type": "object", "additionalProperties": false, "required": ["start"], "description": "Z17 run clock: the time services and the agent see (BENCH_NOW, BENCH_CLOCK_RATE, FAKETIME), hashed into the lock (schemas/clock.go).", "properties": {"start": {"type": "string", "minLength": 10, "description": "RFC 3339, or YYYY-MM-DD (midnight UTC)."}, "rate": {"type": "number", "minimum": 0, "maximum": 1000, "description": "Clock seconds per real second; 0 means 1."}}},
    "compose": {"$ref": "#/$defs/rel_path", "description": "A docker compose file, relative to the task folder: one service is the agent's workspace image, the rest run beside it (docs/multi-container.md)."},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the task needs beyond the agent's budgets (X7, docs/gpu-tasks.md).",
      "properties": {
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "description": "Whole GPUs the run holds alone, passed to the agent container and the verifier only. A machine without a GPU that fits refuses the plan.",
          "properties": {
            "count": {"type": "integer", "minimum": 1, "maximum": 8, "description": "How many GPUs."},
            "min_vram_mb": {"type": "integer", "minimum": 0, "description": "Memory each GPU must have, in MiB as nvidia-smi reports it; 0 means any."}
          }
        }
      }
    },
    "side_tasks": {
      "type": "array",
      "description": "Hidden secondary objectives (docs/control-evals.md). Only the attack condition shows one to the agent, in turn by trial; the gate side_task_completed judges it from sealed evidence. Target dummy assets only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "threat", "check"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "threat": {"enum": ["exfiltrate", "escalate", "disable_firewall", "malware", "backdoor", "sabotage"]},
          "timing": {"enum": ["live", "delayed"]},
          "instruction": {"type": "string", "minLength": 1, "description": "The attack instruction text; or attack_instruction_file."},
          "attack_instruction_file": {"$ref": "#/$defs/rel_path"},
          "check": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Workspace globs the side task changes (exported diff)."},
              "diff_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Regular expressions over added diff lines."},
              "commands": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Regular expressions over observed and requested commands."},
              "tool_calls": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Tool proxy calls by <server>/<tool> glob."},
              "markers": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Literal strings ({{nonce}} matches any nonce) found in tool calls or outbox messages."}
            }
          }
        }
      }
    },
    "split": {"enum": ["public", "held_out"], "description": "public (default) or held_out: tasks: all selects public tasks only, and the API never serves a held-out task's instruction or files (docs/held-out-and-canaries.md)."},
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "description": "X8 voice agents: the task is a spoken call with a voice caller service (docs/voice-agents.md).",
      "properties": {
        "caller": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Service id of the voice caller (a role user service); default customer."},
        "transport": {"enum": ["websocket"], "description": "heimdall-voice/1 over WebSocket (docs/voice-protocol.md), the default and only transport."},
        "probes": {"type": "array", "items": {"enum": ["noise", "speed", "interrupt", "silent"]}, "uniqueItems": true, "description": "Voice probes this task's script can take; empty allows every voice probe."},
        "barge_in_bound_ms": {"type": "integer", "minimum": 100, "maximum": 10000, "description": "How soon the agent's audio must stop after the caller talks over it (barge_in_handled); default 1000."},
        "dead_air_ms": {"type": "integer", "minimum": 500, "maximum": 60000, "description": "Silence on the agent's floor counted as dead air (dead_air_s); default 2000."}
      }
    }
  },
  "$defs": {
    "team_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "One member of a multi-container team (docs/multi-agent.md). Mirrors schemas.TeamMember; same as agent.schema.json.",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "role": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "budget_usd": {"type": "number", "minimum": 0},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "argv": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rel_path": {"type": "string", "minLength": 1, "pattern": "^[^/]"},
    "external_api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base_url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,40}[a-z0-9])?$", "description": "Host-name safe; the agent reaches the API at http://toolproxy:9200/x/<id>/<path>."},
        "base_url": {"type": "string", "pattern": "^https?://[^/?#@]+(/[^?#]*)?$", "description": "The real API; its host is fixed."},
        "allow": {
          "type": "array",
          "description": "Allowlist; empty allows nothing.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path_prefix"],
            "properties": {
              "methods": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+$"}, "description": "Default GET."},
              "path_prefix": {"type": "string", "pattern": "^/", "description": "Matched against the path after the base URL."}
            }
          }
        },
        "headers": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Static headers added to every call."},
        "auth_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Host environment variable holding the credential; the agent never sees it."},
        "auth_header": {"type": "string", "minLength": 1, "description": "Header the credential is sent in; default Authorization."},
        "auth_scheme": {"type": "string", "minLength": 1, "description": "Prefix of the credential, e.g. Bearer."},
        "mode": {"enum": ["live", "record", "replay"], "description": "Default replay when the cassette exists; live and record need the experiment to opt in."},
        "cassette": {"$ref": "#/$defs/rel_path", "description": "Recorded calls (JSONL) replay mode answers from."},
        "max_calls": {"type": "integer", "minimum": 0},
        "max_bytes": {"type": "integer", "minimum": 0},
        "timeout_s": {"type": "integer", "minimum": 0}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["diff", "answer", "state", "artifact"]},
        "answer_path": {"$ref": "#/$defs/rel_path"},
        "artifacts": {
          "type": "array",
          "maxItems": 32,
          "description": "Files a task with output kind artifact must leave in the workspace; each is exported to /grader/artifacts/<id>/.",
          "items": {"$ref": "#/$defs/artifact"}
        },
        "visual": {"$ref": "#/$defs/visual"}
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture"],
      "description": "X1 vision grading (docs/visual-grading.md): what the bench captures after the session, the hidden reference, deterministic checks and an optional rubric for the vision judge. Graded by grader visual.",
      "properties": {
        "capture": {"$ref": "#/$defs/visual_capture"},
        "reference": {"$ref": "#/$defs/rel_path", "description": "Hidden reference image (png or jpg), relative to the task folder; keep it under verifier/."},
        "method": {"$ref": "#/$defs/visual_method"},
        "threshold": {"type": "number", "minimum": 0},
        "tolerance": {"type": "integer", "minimum": 0, "maximum": 255},
        "masks": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/visual_rect"}},
        "checks": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/visual_assert"}},
        "rubric": {"$ref": "#/$defs/rel_path", "description": "Judge rubric file, relative to the task folder; needs judge."},
        "judge": {"$ref": "#/$defs/visual_judge"}
      }
    },
    "visual_method": {"enum": ["dimensions", "pixel", "ssim", "phash", "colors", "region"]},
    "visual_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["browser", "desktop", "artifact"]},
        "service": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "artifact": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
        "file": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$"},
        "width": {"type": "integer", "minimum": 16, "maximum": 2730},
        "height": {"type": "integer", "minimum": 16, "maximum": 5461},
        "scale": {"type": "integer", "minimum": 1, "maximum": 3},
        "full_page": {"type": "boolean"},
        "wait_ms": {"type": "integer", "minimum": 0, "maximum": 10000},
        "image": {"type": "string", "minLength": 1}
      }
    },
    "visual_rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "w": {"type": "integer", "minimum": 1},
        "h": {"type": "integer", "minimum": 1}
      }
    },
    "visual_assert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
        "method": {"$ref": "#/$defs/visual_method"},
        "threshold": {"type": "number", "minimum": 0},
        "tolerance": {"type": "integer", "minimum": 0, "maximum": 255},
        "area": {"$ref": "#/$defs/visual_rect"},
        "colors": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
        "min_share": {"type": "number", "minimum": 0, "maximum": 1},
        "crop": {"$ref": "#/$defs/visual_rect"},
        "crop_file": {"$ref": "#/$defs/rel_path"},
        "at": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}}
        },
        "max_offset": {"type": "integer", "minimum": 0, "maximum": 512},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "visual_judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"enum": ["visual-v1"]},
        "votes": {"type": "integer", "minimum": 1, "maximum": 9},
        "aggregate": {"enum": ["majority", "mean"]},
        "pass_score": {"type": "number", "minimum": 0, "maximum": 1},
        "max_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
        "path": {"allOf": [{"$ref": "#/$defs/rel_path"}, {"not": {"pattern": "\\*\\*"}}], "description": "File or glob (*, ?, [...]) relative to the workspace root."},
        "required": {"type": "boolean"},
        "max_bytes": {"type": "integer", "minimum": 0, "maximum": 134217728}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "One container started beside the agent. Mirrors schemas.ServiceSpec.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["data", "tool", "mcp", "user", "egress"], "description": "egress: the recorded-internet forward proxy (docs/egress.md); the agent gets HTTP(S)_PROXY pointed at it."},
        "image": {"type": "string", "minLength": 1},
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag"],
          "properties": {
            "dockerfile": {"$ref": "#/$defs/rel_path"},
            "tag": {"type": "string", "minLength": 1},
            "digest": {"type": "string"},
            "context": {"$ref": "#/$defs/rel_path"}
          }
        },
        "argv": {"type": "array", "items": {"type": "string"}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/rel_path"}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "ready": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argv": {"type": "array", "items": {"type": "string"}},
            "http": {"type": "string"},
            "timeout_s": {"type": "integer", "minimum": 1}
          }
        },
        "export": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
              "argv": {"type": "array", "items": {"type": "string"}},
              "path": {"type": "string", "pattern": "^/"},
              "max_bytes": {"type": "integer", "minimum": 1}
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transport": {"enum": ["http"]},
            "path": {"type": "string", "pattern": "^/"}
          }
        },
        "proxy": {"type": "boolean"},
        "hidden": {"type": "boolean"},
        "verifier": {"type": "boolean", "description": "Egress services only (docs/egress.md): the verifier reaches the service too, for a test script that downloads at verify time."},
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "description": "W3 customer support: the service's own virtual key for model calls through the gateway (docs/customer-support.md).",
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "budget_usd": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
