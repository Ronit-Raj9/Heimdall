{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximhq/bifrost/bench/spec/agent.schema.json",
  "title": "Bifrost Bench agent config",
  "description": "agents/<id>.yaml: the system under test. Mirrors schemas.AgentConfig. String values may hold {{...}} template variables.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "adapter"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "adapter": {"enum": ["command", "scripted", "remote_http", "a2a", "openai_agent", "voice_platform", "voice_rtc", "pull"]},
    "image": {"type": "string", "minLength": 1},
    "build": {"$ref": "#/$defs/image"},
    "argv": {"type": "array", "items": {"type": "string"}},
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "files": {
      "type": "object",
      "patternProperties": {"^/": {"type": "string"}},
      "additionalProperties": false,
      "description": "Container path to content template."
    },
    "model": {"type": "string"},
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_file"],
      "properties": {
        "project_file": {"type": "string", "minLength": 1, "pattern": "^[^/]", "description": "Repo file the agent reads; the stale-notes probe overwrites it."},
        "user_file": {"type": ["string", "null"], "description": "Host file installed as user-level instructions."},
        "user_path": {"type": ["string", "null"], "description": "Where user_file is installed, outside the workspace."}
      }
    },
    "parser": {"type": "string", "description": "Empty or absent means gateway-level evidence only."},
    "agent_version": {"type": "string", "description": "Optional harness version recorded in the run metadata."},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Optional immutable image digest."},
    "capabilities": {"type": "array", "items": {"enum": ["shell", "tools", "mcp", "sessions", "browser", "desktop", "voice", "gpu"]}, "description": "What the agent can do. Empty uses the defaults of its adapter."},
    "adapter_capabilities": {"$ref": "#/$defs/capabilities"},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_s", "cpus", "mem_gb"],
      "properties": {
        "wall_s": {"type": "integer", "minimum": 1},
        "turns": {"type": "integer", "minimum": 0},
        "cpus": {"type": "number", "exclusiveMinimum": 0},
        "mem_gb": {"type": "number", "exclusiveMinimum": 0},
        "pids_limit": {"type": "integer", "minimum": 0},
        "usd": {"type": "number", "minimum": 0},
        "max_retries": {"type": "integer", "minimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 0}
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "max_retries": {"type": "integer", "minimum": 0},
        "fallbacks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "routing": {"$ref": "#/$defs/routing", "description": "W9 routing policy under test (docs/routing-experiments.md). Mirrors schemas.RoutingPolicy."},
        "models": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}, "description": "X8 voice agents: more models of the same provider the run's key may call beside the arm's model (for example whisper-1 and gpt-4o-mini-tts); docs/voice-agents.md."},
        "bifrost": {"$ref": "#/$defs/bifrost_features", "description": "B2 Bifrost features under test (docs/bifrost-features.md). Mirrors schemas.BifrostFeatures."}
      }
    },
    "scripted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["oracle", "noop", "exploit", "refuse", "toy", "team", "subagents", "mcploop", "empty", "mutant", "wrong_answer"]},
        "index": {"type": "integer", "minimum": 1, "description": "1-based: which mutant (controls.mutants) or which wrong answer of the hidden answer spec a mutant or wrong_answer control writes. It changes nothing on other kinds."}
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the agent is told about the run's MCP servers. Mirrors schemas.AgentMCP.",
      "properties": {
        "format": {"enum": ["codex_toml", "claude_json", "opencode_json", "generic_json", "env"]},
        "config_path": {"type": "string", "pattern": "^/"}
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "description": "Agent skills. Mirrors schemas.AgentSkills.",
      "properties": {
        "enabled": {"type": "boolean", "description": "Default true; false installs no skills."},
        "dir": {"type": "string", "pattern": "^/", "description": "Container folder the agent reads skills from."},
        "extra": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Skill folders relative to the bench root."},
        "set": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "description": "Use the task folder skill-sets/<set> instead of the task's skills folder; a task without it installs no task skills."}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container paths kept between the sessions of a multi-session task. Mirrors schemas.AgentMemory.",
      "properties": {
        "paths": {"type": "array", "items": {"type": "string", "pattern": "^/"}}
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "description": "A deployed agent, read by the remote_http adapter. Mirrors schemas.RemoteAgent.",
      "properties": {
        "url": {"type": "string", "pattern": "^https?://"},
        "auth_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Host environment variable holding the bearer token."},
        "timeout_s": {"type": "integer", "minimum": 1},
        "model_traffic": {"enum": ["gateway", "external"]},
        "tools": {"enum": ["expose", "off"], "description": "expose publishes the run's tool proxy to the deployment behind a per-run bearer token (docs/remote-execution.md)."},
        "artifacts": {"enum": ["inline", "none"], "description": "inline: the deployment returns artifact files in its response."},
        "sign_env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Host environment variable holding the HMAC secret each request body is signed with."},
        "auth_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Org secret (Settings > Secrets) sent as the auth token; used instead of auth_env."},
        "auth_header": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$", "description": "Header the token goes in. Empty or Authorization sends 'Authorization: Bearer <token>'; another name sends the raw token."},
        "sign_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Org secret (Settings > Secrets) each request body is signed with (HMAC-SHA256); used instead of sign_env."},
        "tool_allow": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "With tools expose: only these tool and MCP service ids (and external API ids) are sent to the deployment. Empty sends every one."},
        "mapping": {
            "type": "object",
            "additionalProperties": false,
            "description": "Lane Y10: the endpoint's own request and answer shape. Mirrors schemas.RemoteMapping (docs/remote-execution.md, Request and answer mapping).",
            "properties": {
              "preset": {"type": "string"},
              "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "get", "post", "put", "patch", "delete"]},
              "headers": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Extra headers; values may hold {{secret.NAME}}."},
              "query": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Extra query parameters; values may hold {{secret.NAME}}."},
              "body": {"type": "string", "description": "Request template: JSON with placeholders such as {{instruction}}, {{messages}}, {{session_id}}."},
              "answer_path": {"type": "string", "description": "JSONPath-like path to the answer, for example choices[0].message.content."},
              "stream": {"enum": ["sse", "aws_eventstream"]},
              "stream_path": {"type": "string"},
              "stream_decode": {"enum": ["base64"]},
              "start": {"type": "object", "additionalProperties": false, "required": ["url"], "properties": {"method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "get", "post", "put", "patch", "delete"]}, "url": {"type": "string", "minLength": 1}, "headers": {"type": "object", "additionalProperties": {"type": "string"}}, "body": {"type": "string"}, "id_path": {"type": "string"}}},
              "end": {"type": "object", "additionalProperties": false, "required": ["url"], "properties": {"method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "get", "post", "put", "patch", "delete"]}, "url": {"type": "string", "minLength": 1}, "headers": {"type": "object", "additionalProperties": {"type": "string"}}, "body": {"type": "string"}, "id_path": {"type": "string"}}},
              "poll": {"type": "object", "additionalProperties": false, "required": ["url", "answer_path"], "properties": {"url": {"type": "string", "minLength": 1}, "answer_path": {"type": "string", "minLength": 1}, "interval_s": {"type": "integer", "minimum": 0, "maximum": 30}, "reply_id_path": {"type": "string"}, "status_path": {"type": "string"}, "done_states": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 40}}, "fail_states": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 40}}, "complete_path": {"type": "string"}}}
            }
        },
        "auth": {
            "type": "object",
            "additionalProperties": false,
            "description": "Lane Y10: OAuth 2 client credentials, Microsoft Entra ID, AWS SigV4, a Google ID token and/or mutual TLS. Mirrors schemas.RemoteAuth. Every credential is a Settings > Secrets name.",
            "properties": {
              "type": {"enum": ["oauth2_client_credentials", "azure_entra", "aws_sigv4", "gcp_id_token"]},
              "token_url": {"type": "string", "pattern": "^https://"},
              "tenant_id": {"type": "string"},
              "client_id_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "client_secret_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "scope": {"type": "string"},
              "audience": {"type": "string"},
              "access_key_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "secret_key_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "session_token_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "region": {"type": "string"},
              "service": {"type": "string"},
              "service_account_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "client_cert_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "client_key_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "ca_cert_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
            }
        }
      }
    },
    "voice_platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform"],
      "description": "A voice agent hosted on Vapi, Retell, ElevenLabs Agents or the team's own call WebSocket, read by the voice_platform adapter and the conversation driver. Mirrors schemas.VoicePlatformAgent (docs/voice-platforms.md).",
      "properties": {
        "platform": {"enum": ["vapi", "retell", "elevenlabs", "websocket"]},
        "agent_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$", "description": "The platform's assistant or agent id; not used by websocket."},
        "api_key_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Org secret (Settings > Secrets) holding the platform API key or the endpoint's bearer token."},
        "url": {"type": "string", "pattern": "^(https?|wss?)://", "description": "API base override, or the wss:// endpoint of a websocket platform."},
        "framing": {"enum": ["twilio", "vapi", "elevenlabs"], "description": "Audio framing of a websocket endpoint; default twilio."},
        "timeout_s": {"type": "integer", "minimum": 0, "maximum": 3600}
      }
    },
    "openai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "description": "A08: an agent served as an OpenAI-compatible chat/completions or Responses endpoint, read by the openai_agent adapter. Mirrors schemas.OpenAIAgent (docs/openai-agents.md).",
      "properties": {
        "url": {"type": "string", "pattern": "^https?://", "description": "API base (https://host/v1) or the full .../chat/completions or .../responses URL."},
        "api": {"enum": ["chat", "responses"]},
        "model": {"type": "string", "description": "Model field sent; default the agent's model."},
        "api_key_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Org secret (Settings > Secrets) sent as a Bearer token."},
        "tools": {"enum": ["auto", "off"]},
        "max_turns": {"type": "integer", "minimum": 1},
        "system": {"type": "string"},
        "timeout_s": {"type": "integer", "minimum": 1}
      }
    },
    "voice_rtc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "description": "A real-time voice agent reached over a LiveKit room or a phone number through LiveKit SIP, read by the voice_rtc adapter. Mirrors schemas.VoiceRTCAgent (docs/voice-realtime.md).",
      "properties": {
        "mode": {"enum": ["livekit", "sip"]},
        "livekit": {"$ref": "#/$defs/voice_rtc_livekit"},
        "sip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number"],
          "properties": {
            "number": {"type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$", "description": "The agent's phone number, E.164. Only numbers on the operator's allowlist are dialled."},
            "trunk_id": {"type": "string"},
            "trunk_address": {"type": "string"},
            "from_number": {"type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$"},
            "trunk_user_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "trunk_password_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "transport": {"enum": ["udp", "tcp", "tls"]},
            "livekit": {"$ref": "#/$defs/voice_rtc_livekit"}
          }
        },
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "a2a": {
      "type": "object",
      "additionalProperties": false,
      "description": "B1: an A2A agent reached through Bifrost's agent gateway, read by the a2a adapter. Mirrors schemas.A2AAgent (docs/a2a-agents.md).",
      "properties": {
        "card_url": {"type": "string", "pattern": "^https?://", "description": "The agent's own agent card URL as Bifrost reaches it; the bench registers it per run."},
        "registration": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "An existing registration that allows any virtual key; the bench never edits it."},
        "streaming": {"type": "boolean"},
        "timeout_s": {"type": "integer", "minimum": 1},
        "credential": {"enum": ["forward", "none"]},
        "tools": {"enum": ["expose", "off"]},
        "artifacts": {"enum": ["inline", "none"]},
        "team": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "card_url"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
              "card_url": {"type": "string", "pattern": "^https?://"},
              "role": {"type": "string"},
              "budget_usd": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "team": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/team_member"}, "description": "Multi-container team: one container per member on the run network, each on its own gateway virtual key, under the run-wide cap budgets.usd (docs/multi-agent.md)."},
    "pull": {
      "type": "object",
      "additionalProperties": false,
      "description": "An agent that runs in the customer's own process and takes each turn from Heimdall, read by the pull adapter. Mirrors schemas.PullAgent.",
      "properties": {
        "name": {"type": "string"},
        "timeout_s": {"type": "integer", "minimum": 0},
        "turn_timeout_s": {"type": "integer", "minimum": 0},
        "tools": {"enum": ["", "auto", "off"]},
        "max_tool_rounds": {"type": "integer", "minimum": 0},
        "repo": {"enum": ["", "tarball", "none"]},
        "conversation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Mirrors schemas.ConversationSpec.",
          "properties": {
            "driver": {"enum": ["", "agent", "bench"]},
            "history": {"enum": ["", "client", "server"]},
            "max_turns": {"type": "integer", "minimum": 0, "maximum": 100},
            "greeting": {"type": "string", "maxLength": 2000}
          }
        }
      }
    },
    "topology": {"enum": ["single", "best_of_n", "orchestrator_worker", "team", "swarm"], "description": "Labels the arm for topology comparisons and the equal_budget fairness report."},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Spawn caps frozen in the manifest; the over_spawn gate compares the run's agent tree with them. Zero or absent: no cap.",
      "properties": {
        "max_agents": {"type": "integer", "minimum": 0},
        "max_depth": {"type": "integer", "minimum": 0},
        "max_concurrent": {"type": "integer", "minimum": 0}
      }
    },
    "approver": {"type": "boolean", "description": "Start the approval channel (MCP service approver: request_approval, ask_user) on every run of this agent."},
    "permissions_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Extra paths of the agent's own permission and configuration files that agent_config_modified watches."}
  },
  "allOf": [
    {
      "if": {"required": ["adapter"], "properties": {"adapter": {"const": "command"}}},
      "then": {"required": ["image", "argv"]}
    },
    {
      "if": {"required": ["adapter"], "properties": {"adapter": {"const": "scripted"}}},
      "then": {"required": ["scripted"]}
    },
    {
      "if": {"required": ["adapter"], "properties": {"adapter": {"const": "remote_http"}}},
      "then": {"required": ["remote"]}
    },
    {
      "if": {"required": ["adapter"], "properties": {"adapter": {"const": "a2a"}}},
      "then": {"required": ["a2a"]}
    },
    {
      "if": {"required": ["adapter"], "properties": {"adapter": {"const": "openai_agent"}}},
      "then": {"required": ["openai"]}
    },
    {
      "if": {"required": ["adapter"], "properties": {"adapter": {"const": "voice_platform"}}},
      "then": {"required": ["voice_platform"]}
    },
    {
      "if": {"required": ["adapter"], "properties": {"adapter": {"const": "voice_rtc"}}},
      "then": {"required": ["voice_rtc"]}
    }
  ],
  "$defs": {
    "voice_rtc_livekit": {
      "type": "object",
      "additionalProperties": false,
      "description": "The LiveKit server and how the agent joins the room. Empty url: Heimdall's own LiveKit server.",
      "properties": {
        "url": {"type": "string", "pattern": "^wss?://"},
        "api_key_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "api_secret_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "dispatch": {"enum": ["agent", "auto", "webhook"]},
        "agent_name": {"type": "string"},
        "start_url": {"type": "string", "pattern": "^https?://"},
        "start_token_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "room_prefix": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"}
      }
    },
    "bifrost_features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"code_mode": {"type": "boolean", "description": "Code Mode clients: the agent sees listToolFiles, readToolFile, getToolDocs and executeToolCode."}, "tools": {"type": "array", "items": {"type": "string", "minLength": 1}}, "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}}},
          "description": "Serve the task's MCP servers through Bifrost's MCP gateway (one client per server per run, granted to the run's key only)."
        },
        "prompt_cache": {"enum": ["auto_inject", "off"], "description": "Value of the x-bf-prompt-cache-auto-inject header the agent is asked to send."},
        "semantic_cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "scope"],
          "properties": {
            "mode": {"enum": ["direct", "semantic"]},
            "scope": {"enum": ["task", "arm", "experiment"]},
            "ttl": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h|d)$"},
            "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          }
        },
        "prompt": {"type": "object", "additionalProperties": false, "required": ["name", "version", "messages", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "source_id": {"type": "string"}, "messages": {"type": "array", "items": {"type": "object"}}, "model_params": {"type": "object"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {"enum": ["fixed", "weighted", "fallback_chain", "rule"]},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/route_target"}},
        "fallbacks": {"type": "array", "items": {"$ref": "#/$defs/route_target"}},
        "when": {"type": "string", "description": "rule strategy: CEL condition (Bifrost routing-rule variables)."},
        "retries": {"type": "integer", "minimum": 0, "description": "Must equal the gateway provider's max_retries; Bifrost sets retries per provider."},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "budget_usd": {"type": "number", "minimum": 0},
            "budget_reset": {"type": "string"},
            "request_max": {"type": "integer", "minimum": 0},
            "request_reset": {"type": "string"},
            "token_max": {"type": "integer", "minimum": 0},
            "token_reset": {"type": "string"}
          }
        }
      }
    },
    "route_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "minimum": 0}
      }
    },
    "team_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "One member of a multi-container team (docs/multi-agent.md). Mirrors schemas.TeamMember.",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "role": {"type": "string", "minLength": 1, "description": "lead, worker, router, judge, reviewer or any other label; lead, router and judge count as orchestration."},
        "agent": {"type": "string", "minLength": 1, "description": "Agent config of this member: a path relative to the bench root or a config id. Empty: the arm's own config."},
        "model": {"type": "string", "minLength": 1},
        "budget_usd": {"type": "number", "minimum": 0, "description": "Gateway sub-budget of this member's virtual key."},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "argv": {"type": "array", "items": {"type": "string"}}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag"],
      "properties": {
        "dockerfile": {"type": "string", "minLength": 1, "description": "Dockerfile path, relative to the bench root."},
        "tag": {"type": "string", "minLength": 1, "description": "Image tag; equals image. With base_arg it needs a tag part (name:tag)."},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "base_arg": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Dockerfile ARG that receives the suite's base image; the image is built once per suite and tagged <tag>-<suite id>."},
        "context": {"type": "string", "minLength": 1, "description": "Docker build context, relative to the bench root. Default: the Dockerfile's folder."}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supports_streaming": {"type": "boolean"},
        "supports_structured_events": {"type": "boolean"},
        "supports_tool_events": {"type": "boolean"},
        "supports_notes_file": {"type": "boolean"},
        "supports_model_override": {"type": "boolean"},
        "supports_cancellation": {"type": "boolean"},
        "supports_resume": {"type": "boolean"},
        "supports_gateway_headers": {"type": "boolean"},
        "task_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_levels": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fault_protocol_version": {"enum": ["1"]},
        "fault_hooks": {
          "type": "array", "maxItems": 256,
          "items": {"type": "object", "additionalProperties": false, "required": ["kind", "name", "modes"], "properties": {
            "kind": {"enum": ["tool", "memory", "browser", "retry"]},
            "name": {"type": "string", "minLength": 1, "maxLength": 256},
            "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["error", "timeout", "replace"]}}
          }}
        }
      }
    }
  }
}
