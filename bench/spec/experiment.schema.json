{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximhq/bifrost/bench/spec/experiment.schema.json",
  "title": "Bifrost Bench experiment",
  "description": "experiments/<name>.yaml: arms, conditions, endpoint and verdict policy. Mirrors schemas.Experiment (DESIGN.md 16.6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "suite", "primary", "conditions"],
  "anyOf": [{"required": ["base", "arms"]}, {"required": ["matrix"]}],
  "properties": {
    "id": {"type": "string", "pattern": "^e_[a-z0-9][a-z0-9_]*$", "description": "Set by the planner when absent."},
    "name": {"type": "string", "minLength": 1},
    "suite": {"type": "string", "minLength": 1, "description": "<suite id>[@<version>] or a folder path."},
    "base": {"type": "string", "minLength": 1, "description": "Agent config path every arm starts from."},
    "arms": {
      "type": "object",
      "minProperties": 2,
      "patternProperties": {"^[A-Za-z0-9][A-Za-z0-9_-]*$": {"$ref": "#/$defs/arm"}},
      "additionalProperties": false
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "metric"],
      "properties": {
        "condition": {"$ref": "#/$defs/condition_id"},
        "metric": {"type": "string", "minLength": 1}
      }
    },
    "guards": {"type": "array", "items": {"$ref": "#/$defs/guard"}},
    "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "tasks", "conditions", "trials"],
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "tasks": {"$ref": "#/$defs/task_selector"},
        "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition_id"}},
        "trials": {"type": "integer", "minimum": 1}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_usd"],
      "properties": {
        "total_usd": {"type": "number", "minimum": 0},
        "reserve_usd": {"type": "number", "minimum": 0, "description": "Spend set aside per run before any run has an observed cost, and counted for a run whose cost is unknown. Without it the first run holds the whole remaining cap until a cost is observed."}
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "assumed_sd": {"type": "number", "exclusiveMinimum": 0},
        "allow_uncalibrated_judge": {"type": "boolean", "description": "W8 judge calibration: a judged suite whose judge has no calibration record is labelled instead of capping the verdict at INCONCLUSIVE (docs/judge-calibration.md)."}
      }
    },
    "metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "extra_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "seed": {"type": "integer"},
    "concurrency": {"type": "integer", "minimum": 1},
    "manifest_mode": {"enum": ["agent_exposure", "stack_resilience"]},
    "policy": {"type": "string", "minLength": 1, "description": "Release policy file, relative to the bench root."},
    "smoke": {"type": "boolean", "description": "A synthetic smoke experiment: suite lock problems (no lock, a task not admitted) only warn, and the flag is frozen in the manifest so its results are never presented as findings. The experiment name has no effect."},
    "requirements": {"$ref": "#/$defs/requirements"},
    "external": {"enum": ["live", "record", "replay"], "description": "Overrides every external API's mode for this experiment's runs. live and record call the real hosts: the results are not repeatable, and reports and the leaderboard label or exclude them (docs/external-apis.md)."},
    "simulator": {"$ref": "suite.schema.json#/$defs/simulator", "description": "W3 customer support: overrides the suite's user simulator mode, provider and model for every arm (docs/customer-support.md)."},
    "tier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "W7 suite tiers: the suite tier whose tasks `tasks: all` means (docs/suite-tiers.md)."},
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "description": "W7 adaptive trials: the pre-registered trials design (docs/adaptive-trials.md). Absent or mode fixed: every slot runs.",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["fixed", "adaptive"]},
        "rule": {"enum": ["task", "sequential"]},
        "min": {"type": "integer", "minimum": 1},
        "max": {"type": "integer", "minimum": 2},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "looks": {"type": "integer", "minimum": 2, "maximum": 5},
        "alpha_split": {"enum": ["equal", "obf"]},
        "alphas": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
        "futility": {"enum": ["curtail", "nonbinding", "off"]},
        "extension": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule"],
          "properties": {
            "rule": {"enum": ["inverse_normal"]},
            "alpha_first": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "weight_first": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
          }
        }
      }
    },
    "extends": {
      "type": "object",
      "additionalProperties": false,
      "description": "W7 buy more evidence: the experiment this follow-up extends, written by `extend`.",
      "required": ["exp_id", "manifest_hash", "kind", "rule"],
      "properties": {
        "exp_id": {"type": "string", "minLength": 1},
        "manifest_hash": {"type": "string", "minLength": 1},
        "kind": {"enum": ["tasks", "trials"]},
        "rule": {"enum": ["inverse_normal", "exploratory"]}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "description": "Hosted platform: which runner pool of the organization runs this experiment's slots (docs/runners.md). Without it a hosted experiment runs on pool default; local mode ignores it.",
      "properties": {
        "pool": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "description": "Model comparison matrix (docs/model-matrix.md): expands at plan time into one arm per combination of agent config and model, with generated labels. Replaces arms; without agents every arm uses base.",
      "properties": {
        "models": {"type": "array", "items": {"anyOf": [
          {"type": "string", "minLength": 1},
          {"type": "object", "additionalProperties": false, "required": ["model"], "properties": {"model": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}}}
        ]}},
        "agents": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Agent config paths, relative to the bench root."},
        "allow_unpriced": {"type": "boolean", "description": "Plan a model the price snapshot does not list; its cost per success will be unknown."}
      }
    }
  },
  "$defs": {
    "condition_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "clean or a probe id."},
    "task_selector": {
      "description": "The scalar all, or a list of task ids.",
      "anyOf": [
        {"const": "all"},
        {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}}
      ]
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1, "description": "Overrides the experiment's base config path."},
        "set": {
          "type": "object",
          "description": "Dotted agent config paths to any value, e.g. notes.user_file or model.",
          "patternProperties": {"^(id|adapter|image|build|argv|env|files|model|notes|parser|budgets|gateway|scripted|mcp|skills|memory|remote)(\\..+)?$": true},
          "additionalProperties": false
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule"],
      "properties": {
        "condition": {"$ref": "#/$defs/condition_id"},
        "rule": {"enum": ["no_regression", "no_new_integrity_violation", "timeout_parity"], "description": "timeout_parity holds the release when the arms' timeout rates on condition (every condition when it is absent) are more than 10 pp apart and either is above 20%."},
        "metric": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"rule": {"const": "no_regression"}}},
      "then": {"required": ["condition"]}
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tasks", "trials"],
      "properties": {
        "id": {"$ref": "#/$defs/condition_id"},
        "tasks": {"$ref": "#/$defs/task_selector"},
        "trials": {"type": "integer", "minimum": 1},
        "split": {"enum": ["public", "held_out"], "description": "Which tasks `tasks: all` means: public (default) or held_out. An explicit id list is taken as written (docs/held-out-and-canaries.md)."}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "optional": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
