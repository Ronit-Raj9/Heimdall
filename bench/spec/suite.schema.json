{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximhq/bifrost/bench/spec/suite.schema.json",
  "title": "Bifrost Bench suite",
  "description": "benchmarks/<id>/suite.yaml: one versioned benchmark pack. Mirrors schemas.Suite.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "environment", "grader", "base_image", "workdir", "verifier", "tasks", "probes"],
  "properties": {
    "id": {"$ref": "#/$defs/id", "description": "Pack id; equals the folder name under benchmarks/."},
    "version": {"$ref": "#/$defs/semver"},
    "description": {"type": "string"},
    "environment": {"$ref": "#/$defs/part_name", "description": "Environment part name, e.g. docker_workspace."},
    "grader": {"$ref": "#/$defs/part_name", "description": "Grader part name, e.g. hidden_tests."},
    "base_image": {"$ref": "#/$defs/image"},
    "workdir": {"type": "string", "pattern": "^/", "description": "Absolute workspace path inside containers."},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "timeout_s"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "restore": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Paths reset to the pristine repo before grading."
        },
        "timeout_s": {"type": "integer", "minimum": 1}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
    "probes": {"type": "array", "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "part_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "rel_path": {"type": "string", "minLength": 1, "pattern": "^[^/]"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag"],
      "properties": {
        "dockerfile": {"$ref": "#/$defs/rel_path", "description": "Relative to the suite root."},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Filled by `suite lock`."}
      }
    }
  }
}
