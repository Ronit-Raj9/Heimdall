{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximhq/bifrost/bench/spec/suite.schema.json",
  "title": "Bifrost Bench suite",
  "description": "benchmarks/<id>/suite.yaml: one versioned benchmark pack. Mirrors schemas.Suite.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "environment", "grader", "base_image", "workdir", "verifier", "tasks", "probes"],
  "allOf": [
    {
      "if": {"required": ["grader"], "properties": {"grader": {"const": "hidden_tests"}}},
      "then": {
        "properties": {
          "verifier": {"properties": {"result": {"const": "junit"}, "result_path": false, "pass_threshold": false}}
        }
      }
    }
  ],
  "properties": {
    "id": {"$ref": "#/$defs/id", "description": "Pack id; equals the folder name under benchmarks/."},
    "version": {"$ref": "#/$defs/semver"},
    "description": {"type": "string"},
    "environment": {"$ref": "#/$defs/part_name", "description": "Environment part name, e.g. docker_workspace."},
    "grader": {
      "enum": ["hidden_tests", "verifier_command", "answer_match", "judge", "visual"],
      "description": "Grader part name. hidden_tests: pytest JUnit at /grader/out/junit.xml, the original Python grader. verifier_command: any language, reporting as junit, reward or exit_code (docs/verifiers.md). answer_match and judge: answer tasks (docs/scenarios-design.md). visual: output.visual, images the bench captures (X1, docs/visual-grading.md)."
    },
    "base_image": {"$ref": "#/$defs/image"},
    "workdir": {"type": "string", "pattern": "^/", "description": "Absolute workspace path inside containers."},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "timeout_s"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "restore": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Paths reset to the pristine repo before grading."
        },
        "timeout_s": {"type": "integer", "minimum": 1},
        "result": {
          "enum": ["junit", "reward", "exit_code"],
          "default": "junit",
          "description": "How the command reports (verifier_command only). junit: JUnit XML at result_path. reward: a number, or {\"reward\": n, \"dimensions\": {...}}, at result_path. exit_code: exit 0 passes."
        },
        "result_path": {
          "type": "string",
          "pattern": "^/grader/out/[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$",
          "description": "Result file inside the verifier container, directly in /grader/out, which the grader creates empty for each grade. Default /grader/out/junit.xml or /grader/out/reward.json."
        },
        "pass_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000,
          "default": 1,
          "description": "Lowest reward that passes (result reward only)."
        },
        "mode": {"enum": ["clean_room", "snapshot"], "description": "clean_room (default) or snapshot (docs/scenarios-design.md)."}
      },
      "allOf": [
        {
          "if": {"required": ["result"], "properties": {"result": {"const": "exit_code"}}},
          "then": {"properties": {"result_path": false}}
        },
        {
          "if": {"not": {"required": ["result"], "properties": {"result": {"const": "reward"}}}},
          "then": {"properties": {"pass_threshold": false}}
        }
      ]
    },
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "probes": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "track": {"enum": ["coding", "terminal", "tool_use", "mcp", "memory", "skills", "safety", "qa", "browser", "computer_use", "artifact", "support", "research", "voice"], "description": "Leaderboard track; empty means coding. support: W3 customer support. research: W4 research with Tavily. voice: X8 voice agents."},
    "simulator": {"$ref": "#/$defs/simulator", "description": "W3 customer support: the user simulator, pinned like a judge (docs/customer-support.md)."},
    "tiers": {"type": "object", "description": "W7 suite tiers: tier name to the scalar all or a list of task ids, e.g. pr, nightly, headroom (docs/suite-tiers.md).", "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]*$"}, "additionalProperties": {"anyOf": [{"const": "all"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}]}},
    "grading": {"enum": ["verified", "judged"], "description": "verified (default) or judged; a judged suite needs judge."},
    "output": {"$ref": "task.schema.json#/$defs/output"},
    "services": {"type": "array", "items": {"$ref": "task.schema.json#/$defs/service"}, "description": "Started beside the agent in every run; paths relative to the suite root."},
    "external": {"type": "array", "items": {"$ref": "task.schema.json#/$defs/external_api"}, "description": "Real HTTP APIs every task's agent may call through the tool proxy (docs/external-apis.md); cassette paths relative to the suite root."},
    "canary": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "description": "Contamination canary GUID, set by `suite canary` (docs/held-out-and-canaries.md)."},
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "votes": {"type": "integer", "minimum": 1},
        "max_tokens": {"type": "integer", "minimum": 1},
        "auditor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model"],
          "description": "W8 judge calibration: an optional second judge from another provider. Its disagreement marks a run contested for human review; it never changes a grade (docs/judge-calibration.md).",
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "votes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "imported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["importer", "benchmark", "source", "license", "at"],
      "properties": {
        "importer": {"type": "string", "minLength": 1},
        "benchmark": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string"},
        "license": {"type": "string", "minLength": 1},
        "at": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "part_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "rel_path": {"type": "string", "minLength": 1, "pattern": "^[^/]"},
    "simulator": {
      "type": "object",
      "additionalProperties": false,
      "description": "W3 customer support: user simulator settings (schemas.SimulatorSpec).",
      "properties": {
        "mode": {"enum": ["scripted", "llm"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 100},
        "seed": {"type": "integer"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag"],
      "properties": {
        "dockerfile": {"$ref": "#/$defs/rel_path", "description": "Relative to the suite root."},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Filled by `suite lock`."}
      }
    }
  }
}
