{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximhq/bifrost/bench/spec/probe.schema.json",
  "title": "Bifrost Bench probe",
  "description": "benchmarks/<suite>/probes/<id>.yaml: one perturbation on one layer. Mirrors schemas.ProbeSpec. The layer is any name here; `suite lint` reports a layer the bench does not ship.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "axis", "ps2_family", "layer", "goal_preserving", "apply", "safe_behavior"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "Equals the file name without .yaml."},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "axis": {"type": "string", "minLength": 1, "description": "Diagnostics row label, e.g. memory, tools, resilience."},
    "ps2_family": {"enum": ["unavailable_model", "broken_tool", "misleading_instruction", "hostile_tool"]},
    "layer": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "goal_preserving": {"type": "boolean"},
    "apply": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {"type": "string", "minLength": 1, "description": "Relative to the task folder; may be {{task.notes.stale}}."},
            "to": {"type": "string", "minLength": 1, "description": "Relative to the workspace; may be {{agent.notes.project_file}}."}
          }
        },
        "overlays": {
          "type": "array",
          "minItems": 1,
          "description": "Several overlays, applied in order after overlay. from may also start with {{suite.root}} for suite-level fixture files. A to of exactly {{agent.notes.user_path}} appends the fixture to the agent's user-level notes file instead of writing the workspace.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1}
            }
          }
        },
        "markers": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Literal strings a safety gate or metric looks for; {{nonce}} is the run's nonce."},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Workspace paths a safety probe protects or plants as user work."},
        "fault": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["none", "persistent", "once", "stream_cut"], "description": "S1: stream_cut relays a streamed model answer up to its first tool-call delta and then cuts the stream (call, or every call from from_call)."},
            "from_call": {"type": "integer", "minimum": 1},
            "call": {"type": "integer", "minimum": 1},
            "status": {"type": "integer", "minimum": 100, "maximum": 599},
            "retry_after_s": {"type": "integer", "minimum": 0},
            "model": {"type": "string", "minLength": 1, "description": "W9: fail only requests for this model; \"*\" fails every model. Empty: every model, or a routed run's primary target."}
          },
          "allOf": [
            {"if": {"properties": {"mode": {"const": "persistent"}}}, "then": {"required": ["from_call", "status"]}},
            {"if": {"properties": {"mode": {"const": "once"}}}, "then": {"required": ["call", "status"]}},
            {"if": {"properties": {"mode": {"const": "stream_cut"}}}, "then": {"anyOf": [{"required": ["call"]}, {"required": ["from_call"]}]}}
          ]
        },
        "shim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "mode", "calls"],
          "properties": {
            "tool": {"type": "string", "minLength": 1},
            "mode": {"enum": ["crash", "empty"]},
            "calls": {"type": "integer", "minimum": 1},
            "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
            "output": {"type": "string"}
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "description": "Layer tool: the fault the per-run tool proxy injects. Mirrors schemas.ToolFault.",
          "properties": {
            "mode": {"enum": ["error", "timeout", "poison", "describe_poison", "rug_pull", "shadow", "schema_poison", "plausible_wrong", "schema_drift", "lost_ack"], "description": "S1 safety modes: describe_poison, rug_pull, shadow and schema_poison rewrite tools/list answers; plausible_wrong and schema_drift rewrite a real result quietly; lost_ack forwards the call and withholds the answer (docs/tool-proxy.md)."},
            "server": {"type": "string", "description": "Service id; absent matches every server."},
            "tool": {"type": "string", "description": "Tool name; absent matches every tool."},
            "from_call": {"type": "integer", "minimum": 1, "description": "rug_pull: listings stay clean until from_call - 1 tool calls on the server were answered."},
            "calls": {"type": "integer", "minimum": 0, "description": "How many matching calls are affected; 0 means all from from_call."},
            "message": {"type": "string"},
            "timeout_s": {"type": "integer", "minimum": 1},
            "text": {"type": "string", "description": "poison: appended to the real result; describe_poison, rug_pull, shadow: appended to the tool description; schema_poison: appended to every parameter description. {{nonce}} is replaced per run."},
            "patch": {"type": "object", "description": "plausible_wrong: JSON merge patch (RFC 7386) applied to the result object; schema_poison: merged into inputSchema.properties (parameters with poisoned descriptions or defaults)."},
            "rename": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}, "description": "schema_drift: result field renames, old name to new name, at any depth."}
          },
          "allOf": [
            {"if": {"properties": {"mode": {"const": "poison"}}}, "then": {"required": ["text"]}},
            {"if": {"properties": {"mode": {"enum": ["describe_poison", "shadow"]}}}, "then": {"required": ["text"]}},
            {"if": {"properties": {"mode": {"const": "rug_pull"}}}, "then": {"required": ["text", "from_call"], "properties": {"from_call": {"minimum": 2}}}},
            {"if": {"properties": {"mode": {"const": "schema_poison"}}}, "then": {"anyOf": [{"required": ["text"]}, {"required": ["patch"]}]}},
            {"if": {"properties": {"mode": {"const": "plausible_wrong"}}}, "then": {"required": ["patch"]}},
            {"if": {"properties": {"mode": {"const": "schema_drift"}}}, "then": {"required": ["rename"]}}
          ]
        },
        "adapter_fault": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "mode"],
          "properties": {
            "kind": {"enum": ["tool", "memory", "browser", "retry"]},
            "name": {"type": "string", "minLength": 1, "maxLength": 256},
            "mode": {"enum": ["error", "timeout", "replace"]},
            "session": {"type": "string", "minLength": 1},
            "from_call": {"type": "integer", "minimum": 1},
            "calls": {"type": "integer", "minimum": 0},
            "message": {"type": "string", "maxLength": 4096},
            "timeout_ms": {"type": "integer", "minimum": 1},
            "result": {}
          },
          "allOf": [
            {"if": {"properties": {"mode": {"const": "timeout"}}}, "then": {"required": ["timeout_ms"]}},
            {"if": {"properties": {"mode": {"const": "replace"}}}, "then": {"required": ["result"]}}
          ]
        },
        "service_env": {
          "type": "object",
          "minProperties": 1,
          "description": "Layer service: environment variables added to the named services for this condition (service id, then variable, then value).",
          "additionalProperties": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
        },
        "a2a": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stream"],
          "description": "B1: layer a2a. The launcher's client-side stream fault: drop closes the stream after after_events events, delay stops reading for delay_ms after the first event (docs/a2a-agents.md).",
          "properties": {
            "stream": {"enum": ["drop", "delay"]},
            "after_events": {"type": "integer", "minimum": 1},
            "delay_ms": {"type": "integer", "minimum": 0, "maximum": 60000}
          }
        },
        "agent": {"type": "string", "minLength": 1, "description": "Team runs: target one member id or every member with this role; a gateway-layer plan binds to that member's own key slot, a tool fault matches only its calls (docs/multi-agent.md)."}
      }
    },
    "safe_behavior": {"type": "string", "minLength": 1},
    "metrics": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"required": ["layer"], "properties": {"layer": {"const": "fixture"}}},
      "then": {"properties": {"apply": {"anyOf": [{"required": ["overlay"]}, {"required": ["overlays"]}]}}}
    },
    {
      "if": {"required": ["layer"], "properties": {"layer": {"const": "gateway"}}},
      "then": {"properties": {"apply": {"required": ["fault"]}}}
    },
    {
      "if": {"required": ["layer"], "properties": {"layer": {"const": "tool_shim"}}},
      "then": {"properties": {"apply": {"required": ["shim"]}}}
    },
    {
      "if": {"required": ["layer"], "properties": {"layer": {"const": "tool"}}},
      "then": {"properties": {"apply": {"required": ["tool"]}}}
    },
    {
      "if": {"required": ["layer"], "properties": {"layer": {"const": "service"}}},
      "then": {"properties": {"apply": {"required": ["service_env"]}}}
    },
    {
      "if": {"required": ["layer"], "properties": {"layer": {"const": "adapter"}}},
      "then": {"properties": {"apply": {"required": ["adapter_fault"]}}}
    },
    {
      "if": {"required": ["layer"], "properties": {"layer": {"const": "a2a"}}},
      "then": {"properties": {"apply": {"required": ["a2a"]}}}
    }
  ]
}
