# template: browser
# Written by `bifrost-bench suite init`. A browser suite tests an agent that
# operates a web application through a browser. Each task starts two services
# (services: in task.yaml): the web application, built from services/webapp/
# and seeded with the task's seed/db.json, and a headless Chromium behind
# Playwright's MCP server, built from services/browser/. The web application
# is hidden from the agent; the agent is told about the browser in its own
# MCP config format and drives it through the per-run tool proxy, which
# records every browser action in tools.jsonl and can inject tool faults
# (probes/browser-*.yaml). After the agent exits the web application's
# database is exported and the hidden verifier (verifier/tests/verify.py with
# the task's checks.py) reads it at /grader/state and writes a reward. Pages
# and screenshots are never graded. Add tasks with
# `bifrost-bench task init -suite [[.ID]] -id <task>`, which copies the shape
# of the first task below and adds the id to the tasks list.
id: [[.ID]]
version: 0.1.0
description: Browser tasks graded on the web application's final state.
track: browser
environment: docker_workspace
grader: verifier_command
base_image:
[[- if .Dockerfile]]
  dockerfile: base/Dockerfile
[[- end]]
  tag: [[.Image]]
workdir: /workspace
output:
  kind: state
verifier:
  command: ["python3", "/grader/tests/verify.py"]
  result: reward
  result_path: /grader/out/reward.json
  pass_threshold: 1
  restore: []
  timeout_s: 120
tasks: [new-customer]
probes: [model-outage, browser-error-first, browser-slow, hostile-banner]
