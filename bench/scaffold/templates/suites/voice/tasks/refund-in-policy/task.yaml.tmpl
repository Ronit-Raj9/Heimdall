# Sample task written by `bifrost-bench suite init -template voice`. A customer
# phones for a refund; the agent answers the call, works the helpdesk MCP server
# and talks in audio. `bifrost-bench task init -suite [[.ID]] -id <task>`
# copies this shape into a new task.
# The grinder arrived damaged 8 days ago: a full refund is within policy. Refund exactly 45.00, nothing else.
id: refund-in-policy
version: 1.0.0
title: Refund a damaged order within policy, on a call
project: voicedesk
kind: feature
instruction: instruction.md
# A scratch workspace: the work happens through the helpdesk and the call.
repo_dir: repo
# X8 voice agents: the call (bench/voice); thresholds of the voice metrics.
voice:
  caller: customer
  probes: [noise, speed, interrupt, silent]
# W3: whether handing the customer to a human is right (escalation_correct).
escalation: not_expected
services:
  - id: helpdesk
    role: mcp
    # Built from services/voicedesk/ in the suite folder; `suite admit`
    # builds it when it is missing.
    image: bench/[[.ID]]-voicedesk:1
    port: 8000
    mcp: {path: /mcp}
    files:
      /seed/db.json: seed/db.json
    ready:
      argv: ["python3", "-I", "/srv/server.py", "ready"]
      timeout_s: 30
    export:
      - {id: db.json, path: /state/db.json}
  # The customer: the voice caller (voicecaller.py, same image), a role
  # user service the agent dials at ws://customer:8000/call. It speaks the
  # simulated customer's lines (the text simulator's script, or a pinned
  # model in llm mode) with Piper, transcribes the agent's audio (tone code
  # exactly, speech with Whisper tiny.en) and writes the call timeline. It is
  # not proxied: the agent dials it directly on the run's service network.
  - id: customer
    role: user
    image: bench/[[.ID]]-voicedesk:1
    argv: ["python3", "-I", "/srv/voicecaller.py", "serve", "--config", "/sim/user.json", "--state", "/state"]
    port: 8000
    env:
      BENCH_VOICE_TTS: piper
      BENCH_VOICE_STT: auto
    files:
      /sim/user.json: user.json
    ready:
      argv: ["python3", "-I", "/srv/voicecaller.py", "ready"]
      timeout_s: 60
    export:
      - {id: transcript.json, path: /state/transcript.json}
      - {id: timeline.jsonl, path: /state/timeline.jsonl}
      - {id: caller.wav, path: /state/caller.wav}
      - {id: agent.wav, path: /state/agent.wav}
verifier:
  tests: verifier/tests
  required: []
protected: []
controls:
  reference: solution/reference.sh
  empty: controls/empty.sh
  mutants: [controls/mutant-partial-refund.sh, controls/mutant-adds-credit.sh]
  exploit: controls/exploit.sh
timeouts:
  agent_s: 420
capabilities: [tool_use, policy_following, honesty]
difficulty: easy
provenance:
  source: written by bifrost-bench suite init (template voice)
  license: proprietary
  created_by: suite init
