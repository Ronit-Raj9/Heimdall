# Sample task written by `bifrost-bench suite init -template computer-use`.
# The agent edits two values of an INI-style settings file in the mousepad
# text editor and saves it; the hidden verifier reads the saved file from the
# desktop's state dump. `bifrost-bench task init -suite [[.ID]] -id <task>`
# copies this shape into a new task with EDIT ME markers.
id: edit-config
version: 1.0.0
title: Edit a config value in a text editor and save
project: [[.ID]]
kind: feature
instruction: instruction.md
# A scratch workspace: the work happens on the desktop, through its tools.
repo_dir: repo
services:
  - id: desktop
    role: mcp
    # Built from services/desktop/ in the suite folder; `suite admit` builds
    # it when it is missing (the apt step needs the network once).
    image: bench/[[.ID]]-desktop:1
    port: 8000
    mcp: {path: /mcp}
    env:
      DESKTOP_APP: editor
      DESKTOP_OPEN: /home/desk/Documents/settings.conf
    files:
      # Copied under /seed/home; the desktop copies that into /home/desk at
      # start, as the desktop user.
      /seed/home/Documents/settings.conf: seed/Documents/settings.conf
    ready:
      # Ready once the MCP server answers and the app's window is up and
      # focused.
      argv: ["python3", "-I", "/opt/desktop/desktop.py", "ready"]
      timeout_s: 120
    export:
      # The desktop's final state as one JSON document (see desktop.py).
      - id: state.json
        argv: ["python3", "-I", "/opt/desktop/desktop.py", "dump"]
    # Recordings: the screen video ffmpeg writes from the start of the
    # session (2 frames a second). After the state dump, the stop command
    # finishes the file; it is copied into the run at recordings/desktop/,
    # sealed with it and shown on the run page next to the trace. The
    # verifier never sees it.
    recordings:
      stop: ["python3", "-I", "/opt/desktop/desktop.py", "stop-recording"]
      files:
        - {id: screen, path: /tmp/desktop/rec, kind: video}
    # Live view: the run page shows the screen while the agent works (a JPEG
    # every 2 s, display only). In a debug run a person may take control
    # with the input command; the run is then marked human assisted and
    # never counted.
    live:
      frame: ["python3", "-I", "/opt/desktop/desktop.py", "frame"]
      input: ["python3", "-I", "/opt/desktop/desktop.py", "input"]
verifier:
  tests: verifier/tests
  required: []
protected: []
controls:
  # Scripts run in the agent's place with the desktop up. They drive it
  # through the same MCP server the agent gets, keyboard first: the layout
  # is fixed (one maximized window on a 1280x800 screen) and the app has the
  # focus when the service is ready.
  reference: solution/reference.sh
  empty: controls/empty.sh
  mutants: [controls/mutant-port-only.sh, controls/mutant-unsaved.sh]
  exploit: controls/exploit.sh
timeouts:
  agent_s: 1800
capabilities: [computer_use, gui_editing]
difficulty: easy
# split: held_out   # optional; default public. Held-out tasks never run under tasks: all (only when a condition sets split: held_out or names them) and are not served by the UI or API.
provenance:
  source: written by bifrost-bench suite init (template computer-use)
  license: proprietary
  created_by: suite init
