# template: qa
# Written by `bifrost-bench suite init`. A qa suite tests an agent that
# answers a question, here from documents in its workspace. The agent writes
# its answer to answer.txt in the workspace (its path is also in
# BENCH_ANSWER_PATH); when the file is missing the final message is used and
# the source is recorded. The answer_match grader checks it against the
# task's hidden verifier/answer.yaml with no model: exact, contains_all,
# regex, numeric, choice or json. Add tasks with
# `bifrost-bench task init -suite [[.ID]] -id <task>`, which copies the shape
# of the first task below and adds the id to the tasks list.
id: [[.ID]]
version: 0.1.0
description: Question-answering tasks matched against a hidden expected answer, no model in the grade.
track: qa
environment: docker_workspace
grader: answer_match
base_image:
[[- if .Dockerfile]]
  dockerfile: base/Dockerfile
[[- end]]
  tag: [[.Image]]
workdir: /workspace
output:
  kind: answer
  answer_path: answer.txt
# answer_match grades without running a command; the schema still wants one.
verifier:
  command: ["true"]
  timeout_s: 60
tasks: [hotel-cap]
probes: [model-outage]
