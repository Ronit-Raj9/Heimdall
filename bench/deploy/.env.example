# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit a
# real value. docker compose reads it for deploy/docker-compose.yml, and the
# bench process needs the same values in its environment.

# Bifrost management credential, sent as X-Bifrost-Setup-Token on /api.
# Never given to an agent container. Generate with: openssl rand -hex 24
BIFROST_SETUP_TOKEN=replace-with-a-random-token

# Password of Bifrost's Postgres (config and log stores). Postgres sits on
# bench-upstream only and is not published. Generate with: openssl rand -hex 24
BIFROST_PG_PASSWORD=replace-with-a-random-password

# Bearer token for the fault proxy control API writes (PUT/DELETE /plans).
# Shared by the faultproxy service and the bench. Generate with: openssl rand -hex 24
BENCH_FAULTPROXY_TOKEN=replace-with-a-random-token

# Real Anthropic API key. It lives only in the fault proxy, which swaps it in
# for the slot placeholder. Leave empty to run the proxy's scripted model.
ANTHROPIC_API_KEY=
