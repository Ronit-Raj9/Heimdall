# Settings of the demo runner (docs/runners.md, "The demo runner"), read by
# deploy/runner/demo-runner.sh. Copy to deploy/runner/demo-runner.env and fill
# in. No secret goes in this file: the admin API token is read from the file
# HEIMDALL_ADMIN_TOKEN_FILE names (mode 0600).

# The hosted server's public URL.
HEIMDALL_SERVER=https://heimdall.example.com

# The demo organization (slug or id), the same as demo.org in the server config.
HEIMDALL_DEMO_ORG=demo

# File holding an API token (hm_...) of an admin of the demo organization.
HEIMDALL_ADMIN_TOKEN_FILE=/root/.heimdall-demo-admin-token

# The runner: its pool (the demo organization's experiments say
# runner: {pool: demo}), name, slots and its own spend cap per UTC day.
RUNNER_POOL=demo
RUNNER_NAME=demo-runner
RUNNER_SLOTS=1
SPEND_CAP_USD=5

# Where the new runner token is written (mode 0600). install.sh reads it.
RUNNER_TOKEN_FILE=./demo-runner-token
