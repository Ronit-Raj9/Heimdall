# Hosted Heimdall server image: the web UI built with npm, embedded into a
# static Go binary (CGO_ENABLED=0), on a minimal non-root runtime. Built from
# bench/ as the context:
#
#   docker build -f deploy/hosted/Dockerfile.server -t heimdall/server:local .
#   docker build -f deploy/hosted/Dockerfile.server --target runner -t heimdall/runner:local .
#
# deploy/hosted/docker-compose.yml builds both. The build context is filtered
# by Dockerfile.server.dockerignore (next to this file), not by bench's
# .dockerignore, which only admits the prebuilt binary for the fault proxy
# image (bench/Dockerfile, unchanged).
#
# Every base image is pinned by digest (tag kept for reading). To move one:
# docker pull <tag>, then docker inspect --format '{{index .RepoDigests 0}}' <tag>.

# --- UI: npm ci from the lockfile, then vite build into ui/dist ------------
FROM node:22-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS ui
WORKDIR /src/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ui/ ./
# The typecheck in `npm run build` covers the tests too, and the live scoring
# contract test types its fixtures from the Go handlers' golden files
# (ui/components/livescore/live.fixtures.ts imports
# ../../../handlers/testdata/livescore/*.json), so they sit at the same
# relative path here. Only this stage sees them. (S1-fix)
COPY handlers/testdata/livescore /src/handlers/testdata/livescore
RUN npm run build

# --- Go: static binary with the built UI embedded ---------------------------
FROM golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS build
ENV GOWORK=off CGO_ENABLED=0 GOFLAGS=-trimpath
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=ui /src/ui/dist ./ui/dist
RUN test -f ui/dist/index.html \
    && go build -ldflags="-s -w" -o /out/bifrost-bench ./cmd/bifrost-bench \
    && /out/bifrost-bench version

# --- TypeScript SDK for /downloads: compiled with the UI stage's TypeScript
# and packed with npm into a tarball (`npm install <url>`). Nothing is
# published to a registry; the server serves the file. (Y08)
FROM ui AS sdk-ts
WORKDIR /src/clients/typescript
COPY clients/typescript/ ./
RUN /src/ui/node_modules/.bin/tsc -p tsconfig.json --outDir dist --declaration --noEmit false \
    && mkdir -p /out/downloads \
    && npm pack --pack-destination /out/downloads

# --- Downloads served at /downloads (docs/downloads.md, Y08): the command
# line tool for Linux and macOS on amd64 and arm64, the Python SDK wheel and
# sdist, the TypeScript SDK tarball and, when the commit is known, a source
# tarball of this bench module (bench-<commit>.tar.gz, what a runner installs
# from). All built here from this checkout, at HEIMDALL_COMMIT (upgrade.sh
# passes git rev-parse HEAD). SHA256SUMS and manifest.json list them. In its
# own stage so a new commit never rebuilds the server binary above.
FROM build AS downloads
ARG HEIMDALL_COMMIT=""
COPY --from=sdk-ts /out/downloads/ /out/downloads/
RUN set -eu; \
    for p in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64; do \
        os=${p%/*} arch=${p#*/}; \
        GOOS=$os GOARCH=$arch go build -ldflags="-s -w" -o "/out/downloads/bifrost-bench-$os-$arch" ./cmd/bifrost-bench; \
    done; \
    go run ./cmd/heimdall-dist python -src clients/python -out /out/downloads; \
    if [ -n "$HEIMDALL_COMMIT" ]; then \
        go run ./cmd/heimdall-dist source -root . -out /out/downloads -commit "$HEIMDALL_COMMIT"; \
    else \
        echo "HEIMDALL_COMMIT is not set: no source tarball (deploy/hosted/upgrade.sh sets it)"; \
    fi; \
    go run ./cmd/heimdall-dist manifest -dir /out/downloads -commit "$HEIMDALL_COMMIT" -version "$(/out/bifrost-bench version)"

# --- Runtime base: the server without its downloads -------------------------
# Layout: /srv/heimdall is the bench root (read-only, from the image):
# deploy/bench.yaml (the hosted template, replaced by a bind mount in
# compose), benchmarks/, agents/, experiments/ and the price snapshot.
# /var/lib/heimdall is the data volume: runs/ (sealed evidence, per org) and
# releases/. Both data folders exist here owned by the runtime user, so a
# fresh named volume starts with that ownership.
# postgresql18-client: pg_dump and pg_restore matching the Postgres 18
# server, for `bifrost-bench evidence backup` (database dump uploaded to the
# evidence mirror) and `db backup`.
FROM alpine:3.23@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2 AS base
# git: task from a commit, mining and git-ref compares clone public repos.
# python3 + the modal package (venv /opt/modal): Modal has no REST sandbox
# API, so the server's token test and the shared worker's Modal sandboxes run
# sandbox/modal_helper.py with it (HEIMDALL_MODAL_PYTHON).
RUN apk add --no-cache 'postgresql18-client~18' git python3 \
    && python3 -m venv /opt/modal \
    && /opt/modal/bin/pip install --no-cache-dir 'modal==1.6.4' \
    && /opt/modal/bin/python3 -c 'import modal' \
    && addgroup -S -g 10001 heimdall \
    && adduser -S -D -H -h /var/lib/heimdall -u 10001 -G heimdall heimdall \
    && mkdir -p /srv/heimdall/deploy /var/lib/heimdall/runs /var/lib/heimdall/releases \
    && chown -R 10001:10001 /var/lib/heimdall \
    && chmod 0750 /var/lib/heimdall
COPY --from=build /out/bifrost-bench /usr/local/bin/bifrost-bench
COPY benchmarks /srv/heimdall/benchmarks
COPY agents /srv/heimdall/agents
COPY experiments /srv/heimdall/experiments
COPY examples /srv/heimdall/examples
COPY deploy/pricing-snapshot.json /srv/heimdall/deploy/pricing-snapshot.json
COPY deploy/hosted/bench.hosted.yaml /srv/heimdall/deploy/bench.yaml
ENV HOME=/var/lib/heimdall \
    BENCH_RELEASES_ROOT=/var/lib/heimdall/releases \
    HEIMDALL_MODAL_PYTHON=/opt/modal/bin/python3
WORKDIR /srv/heimdall
USER 10001:10001
EXPOSE 8090
# /readyz: the database answers, migrations are current, the runs root is
# writable. busybox wget ships with the base image.
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8090/readyz || exit 1
ENTRYPOINT ["/usr/local/bin/bifrost-bench"]
CMD ["serve", "-config", "/srv/heimdall/deploy/bench.yaml"]

# --- Runtime: the shared worker (compose profile shared-runner) -------------
# The same binary plus the Docker CLI: the runner starts agent containers on
# the host's Docker through the mounted socket. Runs as the same non-root
# user; compose adds the socket's group.
FROM base AS runner
COPY --from=docker:29-cli@sha256:34507eb5069d8be82c95dd3b6987d4250fd5fee49b82e2509b7d7a7030740d6d /usr/local/bin/docker /usr/local/bin/docker
# buildx: the shared runner builds org images in build sessions of their own
# (a fresh rootless BuildKit per build, `docker buildx build --load`), never
# on the host daemon.
COPY --from=docker:29-cli@sha256:34507eb5069d8be82c95dd3b6987d4250fd5fee49b82e2509b7d7a7030740d6d /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
# The same image is each build session's egress guard: iptables and the
# rules script (build-egress.sh), run as root with NET_ADMIN only in the
# guard container; the runner itself stays uid 10001.
USER 0:0
RUN apk add --no-cache iptables ip6tables
COPY --chmod=0755 deploy/hosted/build-egress.sh /usr/local/bin/heimdall-build-egress
USER 10001:10001
HEALTHCHECK NONE
CMD ["version"]

# --- Runtime: the server, with the files it serves at /downloads ------------
# The shared worker (runner, above) does not carry them.
FROM base AS server
COPY --from=downloads /out/downloads /srv/heimdall/downloads
ENV HEIMDALL_DOWNLOADS_DIR=/srv/heimdall/downloads

# The default target is the server.
FROM server
