# Hosted Heimdall settings. Copy to deploy/hosted/.env (chmod 600) and fill
# in; bootstrap.sh does the copy and generates the random values for you.
# deploy/hosted/.env is git-ignored. Never commit a real value, and never
# put a provider API key here: every organization adds its own keys on Models
# & keys, and runs use only those.

# --- Site ----------------------------------------------------------------------
# The public DNS name. Its A/AAAA record must point at this machine before
# the first start, so Caddy can obtain the HTTPS certificate.
HEIMDALL_DOMAIN=heimdall.example.com
# Contact address for the ACME (Let's Encrypt / ZeroSSL) account: expiry and
# revocation notices.
HEIMDALL_ACME_EMAIL=admin@example.com
# Who may create accounts: invite (default), open or closed.
HEIMDALL_SIGNUP=invite

# --- Database ------------------------------------------------------------------
# Postgres password for the heimdall role. Hex only, so it is safe inside the
# connection URL compose builds. Generate with: openssl rand -hex 24
HEIMDALL_PG_PASSWORD=replace-with-a-random-password

# --- Key store -----------------------------------------------------------------
# Encrypts every stored provider key and organization secret: base64 of 32
# random bytes (openssl rand -base64 32). bootstrap.sh generates it when
# empty. Never change it once keys are stored, and keep a copy in your
# secrets manager: backup.sh leaves this file out unless told otherwise.
HEIMDALL_MASTER_KEY=

# --- Runners -------------------------------------------------------------------
# Runs that may use one provider at once through the shared fault proxy, and
# per organization key. Every runner on this host uses the same count.
HEIMDALL_PROVIDER_SLOTS=32
# Free disk (GB) a runner keeps on its run store: below it the runner takes no
# new work and reports disk_low to the server (workers list).
HEIMDALL_RUNNER_MIN_FREE_GB=10

# --- Shared worker (optional, compose profile shared-runner) -------------------
# The secret the shared worker fetches its assignments with and claims each
# organization's worker token with. Empty: no shared worker. openssl rand -hex 32
HEIMDALL_SHARED_RUNNER_SECRET=
# Container runtime of the shared worker: auto (gVisor, every org) or runsc
# (gVisor, orgs set to runsc only). Without gVisor the shared worker does
# not start: install it with sudo sh deploy/hosted/install-gvisor.sh.
HEIMDALL_SHARED_RUNTIME=
# Operator override, logged on every start: 1 lets the shared worker run
# under runc when the host has no gVisor (or with HEIMDALL_SHARED_RUNTIME=runc).
# It then serves only organizations a server admin set to runtime runc;
# new organizations default to gVisor and are not served. Leave empty.
HEIMDALL_SHARED_ALLOW_RUNC=
# Runs at once per organization on the shared worker, capped by each
# organization's limit.
HEIMDALL_SHARED_SLOTS=
# Images from org Dockerfiles build in a session of their own: a fresh
# rootless BuildKit per build behind egress rules, on this network (fixed
# name; default heimdall-buildnet).
HEIMDALL_BUILD_NETWORK=
# AppArmor profile for each build's BuildKit container. Empty: unconfined. Hosts
# that restrict unprivileged user namespaces (Ubuntu 23.10 and later) need
# heimdall-buildkitd, loaded once with deploy/hosted/install-buildkit-apparmor.sh.
HEIMDALL_BUILDKIT_APPARMOR=
# The private image registry on the build network (host:port, default
# registry:5000): org builds take their bench and platform base images from
# it, read-only and pinned by digest. Fill it with deploy/hosted/registry-sync.sh.
HEIMDALL_SHARED_REGISTRY=
# Folder outside the checkout for that registry's credentials and digest
# manifest. Empty: bootstrap.sh, upgrade.sh or registry-sync.sh picks
# /var/lib/heimdall-registry-auth (root) or ~/.config/heimdall/registry-auth
# and writes it here.
HEIMDALL_REGISTRY_AUTH_DIR=
# Host folder (on the data disk) holding that registry's images. Empty: a
# Docker volume.
HEIMDALL_REGISTRY_DIR=
# Host folder of the shared worker's runs, releases and org projects,
# mounted at the same path. Empty: /var/lib/heimdall-shared-runner.
HEIMDALL_RUNNER_DIR=
# Images every organization may pull, comma-separated (a trailing / or : is
# a prefix).
HEIMDALL_SHARED_PLATFORM_IMAGES=
# The model gateway container every org network joins. Empty: found by name.
HEIMDALL_SHARED_GATEWAY_CONTAINER=
# Python with the modal package, for organizations whose runs go to Modal.
HEIMDALL_MODAL_PYTHON=

# The shared gateway's log API for per-organization prompt logs. Empty with
# the shared worker on: http://bifrost:8080; off: no prompt log controls.
HEIMDALL_GATEWAY_LOGS_URL=

# --- Server admins and limits --------------------------------------------------
# Comma-separated emails of server admins: quotas, image approval, kill switch.
HEIMDALL_SERVER_ADMINS=
# API rate limits: cred_burst,cred_per_sec,org_burst,org_per_sec, or off.
# Empty: the built-in defaults.
HEIMDALL_API_RATE_LIMITS=
# Runner image Heimdall starts for an organization's own worker on Fly
# Machines or Kubernetes. Empty: the published default.
HEIMDALL_RUNNER_IMAGE=

# --- Backups -------------------------------------------------------------------
# A passphrase file kept away from the backups: backup.sh then writes an
# encrypted copy of this file beside each dump. Empty: .env is left out.
HEIMDALL_BACKUP_PASSPHRASE_FILE=

# --- Metrics (optional) ---------------------------------------------------------
# Prometheus metrics address inside the compose network, e.g. 0.0.0.0:9090
# (scrape http://heimdall:9090/metrics). No login: never publish it. Empty: off.
HEIMDALL_METRICS_LISTEN=

# --- GitHub sign-in (optional) -------------------------------------------------
# OAuth app callback URL: https://<HEIMDALL_DOMAIN>/api/bench/auth/github/callback
# Leave both empty to offer email and password only.
HEIMDALL_GITHUB_CLIENT_ID=
HEIMDALL_GITHUB_CLIENT_SECRET=

# --- Evidence mirror (optional, S3-compatible) ---------------------------------
# Sealed experiments are copied to the bucket after sealing, and backup.sh
# uploads database backups there. Create the bucket first (the mirror never
# creates one) and keep it private. Empty bucket or empty keys: no mirror.
# Empty endpoint: AWS S3. MinIO, R2 and others: https://host[:port] (R2
# region: auto).
HEIMDALL_S3_BUCKET=
HEIMDALL_S3_REGION=
HEIMDALL_S3_ENDPOINT=
HEIMDALL_S3_ACCESS_KEY=
HEIMDALL_S3_SECRET_KEY=

# --- Built-in benchmark library (optional) --------------------------------------
# Absolute host path of a library folder (benchmarks/<suite-id>/, agents/):
# every organization lists and runs its suites as read-only built-ins. The
# server and the runners mount it read-only at the same path. Empty: no
# library, only each org's own suites.
HEIMDALL_LIBRARY_DIR=

# --- Shared worker's gateway stack (compose profile shared-runner) -------------
# Absolute path of the bench/ folder of this clone; the shared worker mounts
# it at the same path so the agent containers it starts see the same files.
# The helper scripts fill it in when empty.
HEIMDALL_BENCH_DIR=
# Bifrost stack of the shared worker. Generate each with: openssl rand -hex 24
BIFROST_SETUP_TOKEN=replace-with-a-random-token
BIFROST_PG_PASSWORD=replace-with-a-random-password
BENCH_FAULTPROXY_TOKEN=replace-with-a-random-token
# No server-wide provider keys: every organization adds its own on Models &
# keys, and its runs are refused until it has a working key for the model's
# provider. The fault proxy reads no provider key from here.

# Library registry (Z13, docs/library-registry.md): library images pinned
# by digest for every worker. Off unless the override file
# deploy/hosted/library-registry.compose.yml is used
# (HEIMDALL_COMPOSE_OVERRIDE). TOKEN_DIR holds token.key and token.crt
# (bifrost-bench images token-key) and sync.htpasswd (bifrost-bench
# registry htpasswd -user sync); ACCESS names an access file (namespace,
# restricted suites per org); empty: every org pulls the whole library.
HEIMDALL_LIBRARY_REGISTRY_TOKEN_DIR=
HEIMDALL_LIBRARY_REGISTRY_ACCESS=
HEIMDALL_LIBRARY_REGISTRY_DIR=
HEIMDALL_LIBRARY_REGISTRY_PUBLISH=
