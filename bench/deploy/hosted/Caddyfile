# Caddy in front of the hosted Heimdall server (docs/hosting.md). Caddy is
# the only published service: it obtains and renews the certificate for
# $HEIMDALL_DOMAIN, redirects HTTP to HTTPS, sets the transport security
# headers and caps request bodies, then proxies to heimdall:8090 on the
# compose network. The Heimdall server sets its own CSP, framing and
# content-type headers on every answer; Caddy keeps them.
#
# A *.localhost domain or an IP gets a certificate from Caddy's internal CA
# instead of ACME (smoke.sh uses heimdall.localhost).
{
	email {$HEIMDALL_ACME_EMAIL:admin@example.com}
	# No admin API: configuration changes go through a container restart.
	admin off
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

{$HEIMDALL_DOMAIN} {
	encode zstd gzip

	# Deferred: applied as the response is written, so these replace (never
	# duplicate) the same headers coming from the server.
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
		-X-Powered-By
	}

	# Readiness detail (database, migrations, disk) stays on the host:
	# docker compose ps and the container health check read it. /healthz is
	# public for uptime monitors.
	handle /readyz {
		respond "not found" 404
	}

	# Zip uploads (runs, project and agent folders) get their own body cap,
	# matching the server's 64 MiB upload limit (lib.MaxUploadBytes).
	# Large project files (bifrost-bench push, PUT /project/blobs/...) too,
	# and the file uploads of Add benchmark, the catalog datasets, benchmark
	# uploads and agent skills, so a large file gets the server's own answer.
	@uploads path /api/bench/uploads /api/bench/uploads/* /api/bench/project/blobs/* /api/bench/onboard/upload* /api/bench/benchmarks/catalog/*/dataset* /api/bench/suites/*/upload* /api/bench/agents/*/skills*
	handle @uploads {
		request_body {
			max_size {$HEIMDALL_MAX_UPLOAD:64MiB}
		}
		reverse_proxy heimdall:8090 {
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 5s
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# Public ingress (docs/hosting.md "Agents outside the worker"): the
	# shared worker's model gateway under /gw and its live runs' tool gates
	# under /rt, for deployed agents and cloud sandboxes. The worker answers
	# only for live runs: /gw needs the run's virtual key on an inference
	# route, /rt the run's tool token; each run is rate limited there.
	@ingress path /gw /gw/* /rt/*
	handle @ingress {
		request_body {
			max_size {$HEIMDALL_INGRESS_MAX_BODY:32MiB}
		}
		reverse_proxy {$HEIMDALL_INGRESS_UPSTREAM:shared-runner:9300} {
			# Model answers stream (server-sent events) unbuffered.
			flush_interval -1
			transport http {
				dial_timeout 5s
			}
		}
	}

	handle {
		# The API caps bodies at 1 MiB (runner uploads are chunked below
		# it); anything far above is refused here before it reaches it.
		request_body {
			max_size {$HEIMDALL_MAX_BODY:2MiB}
		}
		reverse_proxy heimdall:8090 {
			# Server-sent events (job logs, live runs) stream unbuffered.
			flush_interval -1
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 5s
			}
		}
	}

	# Errors Caddy answers itself (a refused body, an unreachable server).
	handle_errors {
		header -Server
		respond "{err.status_code} {err.status_text}"
	}

	# Access log, JSON. Request URIs can carry credentials: the one-time
	# invitation token in /invite/<token> and /api/bench/auth/invitations/<token>,
	# the OAuth callback's code and state query parameters, and a model
	# client's key query parameter on /gw. The filter
	# replaces each of those values with REDACTED before the line is written.
	# The Referer header can repeat such a URL, so it is dropped. (Cookie and
	# Authorization headers are already redacted by Caddy by default.)
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "((?:/invite/|/api/bench/auth/invitations/)|[?&](?:code|state|key)=)[^/?&#]+" "${1}REDACTED"
				request>headers>Referer delete
			}
		}
	}
}
