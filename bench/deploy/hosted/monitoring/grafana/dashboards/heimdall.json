    {
      "id": 2,
      "type": "stat",
      "title": "API availability: error budget left (30 d)",
      "description": "Share of the 30-day error budget not yet spent (slos.yml).",
      "datasource": {
        "type": "prometheus",
        "uid": "heimdall-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heimdall-prometheus"
          },
          "expr": "slo:period_error_budget_remaining:ratio{sloth_slo=\"api-availability\"}",
          "legendFormat": "api-availability",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
