    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests per second by area",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "heimdall-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "heimdall-prometheus"
          },
          "expr": "sum by (area) (rate(heimdall_http_request_duration_seconds_count{area!~\"health|ui\"}[5m]))",
          "legendFormat": "{{area}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
