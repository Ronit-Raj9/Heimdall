# Host-built binary copied into the bench image (see Dockerfile).
/bin/
# The repo-level .gitignore ignores .env*; the example file holds placeholders only.
!deploy/.env.example
# Run folders are local evidence; the recorded demo bundle lives in testdata/.
/runs/
# A binary built with plain `go build ./cmd/bifrost-bench` from bench/.
/bifrost-bench
# Release log and evidence packs written by `bifrost-bench release`.
/releases/
# The repo-level .gitignore drops *.test (Go test binaries); this is the py.test shim.
!/probes/shims/py.test
/checks/
# Upstream benchmark clones and datasets fetched for `bifrost-bench import`.
/datasets/
