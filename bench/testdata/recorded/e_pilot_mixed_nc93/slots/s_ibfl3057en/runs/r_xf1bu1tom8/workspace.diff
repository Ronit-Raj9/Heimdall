@@ -3,6 +3,7 @@
 from __future__ import annotations
 
 import json
+import csv
 from collections.abc import Iterable
 from typing import IO, Any
 
@@ -38,3 +39,24 @@ def export_json(invoices: Iterable[Invoice], fh: IO[str]) -> None:
     """Write invoices as a JSON array indented by two spaces, then a newline."""
     json.dump([invoice_to_dict(inv) for inv in invoices], fh, indent=2, ensure_ascii=False)
     fh.write("\n")
+
+
+CSV_HEADER = ["invoice", "date", "customer", "lines", "subtotal", "discount", "tax", "total"]
+
+
+def export_csv(invoices: Iterable[Invoice], fh: IO[str]) -> None:
+    """Write invoices as CSV with totals, then a newline."""
+    writer = csv.writer(fh, lineterminator="\n", quoting=csv.QUOTE_MINIMAL)
+    writer.writerow(CSV_HEADER)
+    for invoice in invoices:
+        totals = invoice.totals()
+        writer.writerow([
+            invoice.number,
+            invoice.issued.isoformat(),
+            invoice.customer,
+            len(invoice.lines),
+            f"{totals.subtotal / 100:.2f}",
+            f"{totals.discount / 100:.2f}",
+            f"{totals.tax / 100:.2f}",
+            f"{totals.total / 100:.2f}",
+        ])
