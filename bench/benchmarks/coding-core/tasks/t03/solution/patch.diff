+    match = _DAY_FIRST_RE.fullmatch(value)
+    if match is not None:
+        day, month, year = match.groups()
+        if len(year) == 2:
+            raise ValueError(f"ambiguous date {text!r}: write the year with four digits")
+        if len(year) == 4:
+            return _make_date(text, year, month, day)
+    raise ValueError(f"invalid date {text!r}")
+
+
+def _make_date(text: str, year: str, month: str, day: str) -> date:
