+_DAY_FIRST_RE = re.compile(r"([0-9]{1,2})/([0-9]{1,2})/([0-9]+)")
 
 
 def parse_date(text: str) -> date:
-    """Parse an invoice date written as ``YYYY-MM-DD``.
+    """Parse an invoice date written as ``YYYY-MM-DD`` or ``D/M/YYYY``.
 
