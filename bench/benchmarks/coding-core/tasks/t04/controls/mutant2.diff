index 2004372..ab0f234 100644
--- a/ledger/discounts.py
+++ b/ledger/discounts.py
@@ -72,22 +72,32 @@ class Discount:
 
 
 def parse_discounts(text: str) -> list[Discount]:
-    """Parse the CSV ``discount`` column: empty for none, otherwise one discount."""
+    """Parse the CSV ``discount`` column.
+
+    Empty means no discount. Several discounts are separated by ``+``, as in
+    ``"10%+5.00"``; every part must be a valid discount.
+    """
     value = text.strip()
     if not value:
         return []
-    return [Discount.parse(value)]
+    return [Discount.parse(part) for part in value.split("+")]
 
 
 def total_discount(subtotal: int, discounts: Iterable[Discount]) -> int:
     """Total discount in cents on ``subtotal`` for an invoice's discounts.
 
-    An invoice holds at most one discount, so this is that discount's amount,
-    or 0 when there is none.
+    Percentage discounts are added up and taken from the subtotal at once,
+    rounded half up. Fixed discounts follow,
+    in order. No discount takes more than what is left, so the result never
+    exceeds ``subtotal``.
     """
     items = list(discounts)
-    if not items:
-        return 0
-    if len(items) > 1:
-        raise LedgerError("only one discount per invoice is supported")
-    return items[0].amount_on(subtotal)
+    percents = [d for d in items if d.kind == PERCENT]
+    fixed = [d for d in items if d.kind == FIXED]
+    remaining = subtotal
+    if percents:
+        combined = min(sum((Decimal(d.value) for d in percents), Decimal(0)), Decimal(100))
+        remaining -= Discount(PERCENT, combined).amount_on(remaining)
+    for discount in fixed:
+        remaining -= discount.amount_on(remaining)
+    return subtotal - remaining
