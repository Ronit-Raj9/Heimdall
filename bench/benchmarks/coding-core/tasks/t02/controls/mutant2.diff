diff --git a/ledger/export.py b/ledger/export.py
index 9145903..e8147a8 100644
--- a/ledger/export.py
+++ b/ledger/export.py
@@ -2,11 +2,15 @@
 
 from __future__ import annotations
 
+import csv
 import json
 from collections.abc import Iterable
 from typing import IO, Any
 
 from .invoice import Invoice
+from .money import format_cents
+
+CSV_COLUMNS = ("invoice", "date", "customer", "lines", "subtotal", "discount", "tax", "total")
 
 
 def invoice_to_dict(invoice: Invoice) -> dict[str, Any]:
@@ -38,3 +42,27 @@ def export_json(invoices: Iterable[Invoice], fh: IO[str]) -> None:
     """Write invoices as a JSON array indented by two spaces, then a newline."""
     json.dump([invoice_to_dict(inv) for inv in invoices], fh, indent=2, ensure_ascii=False)
     fh.write("\n")
+
+
+def export_csv(invoices: Iterable[Invoice], fh: IO[str]) -> None:
+    """Write a header row, then one CSV row per invoice with its totals.
+
+    Comma separated, fields quoted only when they need it, every row ending
+    in a bare line feed. Amounts are written like ``1234.50``.
+    """
+    writer = csv.writer(fh, quoting=csv.QUOTE_NONNUMERIC, lineterminator="\n")
+    writer.writerow(CSV_COLUMNS)
+    for invoice in invoices:
+        totals = invoice.totals()
+        writer.writerow(
+            [
+                invoice.number,
+                invoice.issued.isoformat(),
+                invoice.customer,
+                len(invoice.lines),
+                format_cents(totals.subtotal),
+                format_cents(totals.discount),
+                format_cents(totals.tax),
+                format_cents(totals.total),
+            ]
+        )
